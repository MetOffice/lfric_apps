!> @brief Applies JULES site forcing data to the fields used to drive JULES
module apply_jules_forcing_alg_mod

  use field_mod,            only: field_type
  use field_collection_mod, only: field_collection_type
  use mr_indices_mod,       only: nummr, imr_v

  implicit none

  private

  public apply_jules_forcing_alg

contains

  !> @brief Applies JULES site forcing data to the fields used to drive JULES
  !> @details Sets the near-surface atmospheric state, downward radiation and
  !>          precipitation from the fields in jules_forcing_fields, which have
  !>          already been interpolated to the current time.
  !> @param[in,out] theta                Potential temperature (K)
  !> @param[in,out] mr                   Moisture mixing ratios
  !> @param[in]     jules_forcing_fields Site forcing fields
  !> @param[in,out] derived_fields       Derived fields
  !> @param[in,out] radiation_fields     Radiation fields
  !> @param[in,out] microphysics_fields  Microphysics fields
  subroutine apply_jules_forcing_alg( theta, mr, jules_forcing_fields, &
                                      derived_fields, radiation_fields, &
                                      microphysics_fields )

    use jules_forcing_kernel_mod, only: jules_forcing_kernel_type

    implicit none

    type( field_type ),            intent(inout) :: theta
    type( field_type ),            intent(inout) :: mr(nummr)
    type( field_collection_type ), intent(in)    :: jules_forcing_fields
    type( field_collection_type ), intent(inout) :: derived_fields
    type( field_collection_type ), intent(inout) :: radiation_fields
    type( field_collection_type ), intent(inout) :: microphysics_fields

    type( field_type ), pointer :: exner_in_wth
    type( field_type ), pointer :: u_in_w3
    type( field_type ), pointer :: v_in_w3
    type( field_type ), pointer :: wetrho_in_w3
    type( field_type ), pointer :: forcing_wind
    type( field_type ), pointer :: forcing_tair
    type( field_type ), pointer :: forcing_qair
    type( field_type ), pointer :: forcing_psurf
    type( field_type ), pointer :: forcing_lwdown
    type( field_type ), pointer :: forcing_swdown
    type( field_type ), pointer :: forcing_rainf
    type( field_type ), pointer :: sw_down_surf
    type( field_type ), pointer :: lw_down_surf
    type( field_type ), pointer :: sw_down_blue_surf
    type( field_type ), pointer :: sw_direct_blue_surf
    type( field_type ), pointer :: ls_rain
    type( field_type ), pointer :: ls_snow

    call derived_fields%get_field('exner_in_wth', exner_in_wth)
    call derived_fields%get_field('u_in_w3', u_in_w3)
    call derived_fields%get_field('v_in_w3', v_in_w3)
    call derived_fields%get_field('wetrho_in_w3', wetrho_in_w3)

    call jules_forcing_fields%get_field('forcing_wind', forcing_wind)
    call jules_forcing_fields%get_field('forcing_tair', forcing_tair)
    call jules_forcing_fields%get_field('forcing_qair', forcing_qair)
    call jules_forcing_fields%get_field('forcing_psurf', forcing_psurf)
    call jules_forcing_fields%get_field('forcing_lwdown', forcing_lwdown)
    call jules_forcing_fields%get_field('forcing_swdown', forcing_swdown)
    call jules_forcing_fields%get_field('forcing_rainf', forcing_rainf)

    call radiation_fields%get_field('sw_down_surf', sw_down_surf)
    call radiation_fields%get_field('lw_down_surf', lw_down_surf)
    call radiation_fields%get_field('sw_down_blue_surf', sw_down_blue_surf)
    call radiation_fields%get_field('sw_direct_blue_surf', sw_direct_blue_surf)

    call microphysics_fields%get_field('ls_rain', ls_rain)
    call microphysics_fields%get_field('ls_snow', ls_snow)

    call invoke( jules_forcing_kernel_type( theta, mr(imr_v), exner_in_wth,   &
                                            u_in_w3, v_in_w3, wetrho_in_w3,   &
                                            forcing_wind, forcing_tair,       &
                                            forcing_qair, forcing_psurf,      &
                                            forcing_lwdown, forcing_swdown,   &
                                            forcing_rainf,                    &
                                            sw_down_surf, lw_down_surf,       &
                                            sw_down_blue_surf,                &
                                            sw_direct_blue_surf,              &
                                            ls_rain, ls_snow ) )

    nullify( exner_in_wth, u_in_w3, v_in_w3, wetrho_in_w3,                   &
             forcing_wind, forcing_tair, forcing_qair, forcing_psurf,        &
             forcing_lwdown, forcing_swdown, forcing_rainf,                  &
             sw_down_surf, lw_down_surf, sw_down_blue_surf,                  &
             sw_direct_blue_surf, ls_rain, ls_snow )

  end subroutine apply_jules_forcing_alg

end module apply_jules_forcing_alg_mod
