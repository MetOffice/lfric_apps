   call soil_fields%get_field('water_table', temp_field)
   call log_field_minmax(LOG_LEVEL_INFO, 'water_table', temp_field)

   call soil_fields%get_field('wetness_under_soil', temp_field)
   call log_field_minmax(LOG_LEVEL_INFO, 'wetness_under_soil', temp_field)
   
   call soil_fields%get_field('unfrozen_soil_moisture', temp_field)
   call log_field_minmax(LOG_LEVEL_INFO, 'unfrozen_soil_moisture', temp_field)

   call soil_fields%get_field('frozen_soil_moisture', temp_field)
   call log_field_minmax(LOG_LEVEL_INFO, 'frozen_soil_moisture', temp_field)

   call soil_fields%get_field('soil_temperature', temp_field)
   call log_field_minmax(LOG_LEVEL_INFO, 'soil_temperature', temp_field)

   call soil_fields%get_field('soil_moisture', temp_field)
   call log_field_minmax(LOG_LEVEL_INFO, 'soil_moisture', temp_field)

  end subroutine process_inputs_alg

end module process_inputs_alg_mod
