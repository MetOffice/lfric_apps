!> @brief Calculate aviation diagnostics.
!>
module aviation_diags_alg_mod

  use aviation_thickness_snow_kernel_mod,                                   &
                                      only: aviation_thickness_snow_kernel_type
  use cape_cin_mixed_layer_kernel_mod,                                      &
                                      only: cape_cin_mixed_layer_kernel_type
  use cape_cin_surface_kernel_mod,    only: cape_cin_surface_kernel_type
  use config_mod,                     only: config_type
  use constants_mod,                  only: r_def, i_def, l_def, str_long, RMDI
  use dg_matrix_vector_kernel_mod,    only: dg_matrix_vector_kernel_type
  use field_collection_mod,           only: field_collection_type
  use field_mod,                      only: field_type
  use fs_continuity_mod,              only: W2h, W2v, W3, Wtheta
  use function_space_collection_mod,  only: function_space_collection
  use initialise_diagnostics_mod,     only: init_diag => init_diagnostic_field
  use integer_field_mod,              only: integer_field_type
  use lfric_xios_diag_mod,            only: get_axis_dimension, get_axis_values
  use log_mod,                        only: log_event, log_level_error
  use mesh_mod,                       only: mesh_type
  use mr_indices_mod,                 only: imr_v
  use operator_mod,                   only: operator_type
  use planet_config_mod,              only: p_zero, kappa, one_over_kappa,  &
                                            gravity, rd, cp, epsilon
  use psykal_lite_phys_mod,           only: invoke_pres_interp_kernel_type
  use r_tran_operator_mod,            only: r_tran_operator_type
  use sci_geometric_constants_mod,    only: get_face_selector_ew,          &
                                            get_face_selector_ns,          &
                                            get_height_fv
  use sci_operator_algebra_kernel_mod,                                      &
                                      only: operator_setval_x_kernel_type
  use section_choice_config_mod,      only: boundary_layer,                &
                                            boundary_layer_um,             &
                                            surface, surface_jules
  use split_w2_field_kernel_mod,      only: split_w2_field_kernel_type
  use transport_constants_mod,        only: get_directional_im3_div_r_tran
  use transport_enumerated_types_mod, only: direction_h

  implicit none

private
public :: aviation_diags_alg

contains

  !> @brief Calculate aviation diagnostics.
  !> @param[in]     config             Model configuration
  !> @param[in]     plev_geopot        Geopotential height at pressure levels in m.
  !>                                   including cloud base and top pressures.
  !> @param[in]     wind              3D wind field on W2
  !> @param[in]     exner_w3          Exner pressure on W3
  !> @param[in]     theta             Potential temperature
  !> @param[in]     mr                Mixing ratios
  !> @param[in]     rho               Dry density on W3
  !> @param[in]     derived_fields    Collection of derived fields
  !> @param[in]     surface_fields    Collection of surface fields
  !> @param[in]     main_mesh         Primary mesh pointer
  !> @param[in]     element_order_h   Element order in the horizontal
  !> @param[in]     element_order_v   Element order in the vertical
  subroutine aviation_diags_alg(config, plev_geopot,                        &
          wind, exner_w3, theta, mr, rho, derived_fields, surface_fields,   &
          main_mesh, element_order_h, element_order_v)
    implicit none

    ! Arguments
    type(config_type),           intent(in)          :: config
    type(field_type),            intent(in)          :: plev_geopot
    type(field_type),            intent(in)          :: wind
    type(field_type),            intent(in)          :: exner_w3
    type(field_type),            intent(in)          :: theta
    type(field_type),            intent(in)          :: mr(:)
    type(field_type),            intent(in)          :: rho
    type(field_collection_type), intent(in)          :: derived_fields
    type(field_collection_type), intent(in)          :: surface_fields
    type(mesh_type),             intent(in), pointer :: main_mesh
    integer(kind=i_def),         intent(in)          :: element_order_h
    integer(kind=i_def),         intent(in)          :: element_order_v

    ! Calculate geopotential thickness and snow probbability.
    call from_plev_geopot(plev_geopot)

    ! Calculate uv wind divergence.
    call write_horizontal_divergence_diagnostic( &
        wind, exner_w3, main_mesh, element_order_h, element_order_v)

    ! Calculate CAPE and CIN of undilute parcel ascents.
    call write_cape_cin_diagnostics(config, theta, mr, exner_w3, rho,       &
                                    derived_fields, surface_fields)

  end subroutine aviation_diags_alg

  !> @brief Calculate geopotential thickness and snow probabbility
  !>        from geopotential height at pressure levels.
  !> @param[in]    plev_geopot    Geopotential height at pressure levels in m.
  subroutine from_plev_geopot(plev_geopot)
    implicit none

    ! Arguments
    type(field_type), intent(in) :: plev_geopot

    ! Local variables

    ! These flags tell us which results are requested at this time step.
    logical(l_def) :: thick_850_flag, thick_500_flag, snow_probability_flag

    ! The array of pressure levels.
    integer(i_def) :: nplev
    real(r_def), allocatable :: plevs(:)
    integer(i_def) :: plevs_alloc_stat

    ! Level indices for the three pressure levels we want to read.
    integer(i_def) :: i1000, i850, i500

    ! Approximate equality tolerance - is there a common variable somewhere?
    real(r_def), parameter :: plev_tol = 0.1_r_def

    ! The output fields we produce.
    type( field_type ) :: thick_850, thick_500, snow_probability

    integer(i_def) :: i

    character(len=str_long) :: message


    ! Check the request flags.
    snow_probability_flag = &
      init_diag(snow_probability, 'aviation__snow_probability')
    thick_850_flag = &
      init_diag(thick_850, 'aviation__geopot_thickness_850')
    thick_500_flag = &
      init_diag(thick_500, 'aviation__geopot_thickness_500')

    ! Anything to do?
    if ( .not. (thick_850_flag .or. &
                thick_500_flag .or. &
                snow_probability_flag) ) then
      return
    end if

    ! Get the array of pressure levels.
    nplev = get_axis_dimension('pressure_levels')
    if (nplev <= 0) then
      message = 'Aviation: No pressure levels'
      call log_event( message, log_level_error )
    end if

    allocate(plevs(nplev), stat=plevs_alloc_stat)
    if (plevs_alloc_stat /= 0) then
      message = 'Aviation: allocate(plevs) failed'
      call log_event( message, log_level_error )
    end if
    plevs = get_axis_values('pressure_levels',nplev)

    ! Find the level indices for our three pressures of interest.
    ! Assumes hPa.
    i1000 = -1
    i850  = -1
    i500  = -1
    do i = 1, nplev

      ! 1000?
      if (abs(plevs(i) - 100000.0_r_def) < plev_tol) then
        i1000 = i

      ! 850?
      else if (abs(plevs(i) - 85000.0_r_def) < plev_tol) then
        i850 = i

      ! 500?
      else if (abs(plevs(i) - 50000.0_r_def) < plev_tol) then
        i500 = i

      end if
    end do

    ! Check we found the required levels.
    if (i1000 == -1) then
      message = 'Aviation: could not find 1000hPa'
      call log_event( message, log_level_error )
    end if

    if ((thick_850_flag .or. snow_probability_flag) .and. i850 == -1) then
      message = 'Aviation: could not find 850hPa'
      call log_event( message, log_level_error )
    end if

    if (thick_500_flag .and. i500 == -1) then
      message = 'Aviation: could not find 500hPa'
      call log_event( message, log_level_error )
    end if

    ! Call the kernel to subtract the levels.
    call invoke( aviation_thickness_snow_kernel_type(        &
      thick_850, thick_500, snow_probability,                &
      plev_geopot,                                           &
      thick_850_flag, thick_500_flag, snow_probability_flag, &
      i1000, i850, i500))

    ! Write the fields
    if (thick_850_flag) call thick_850%write_field()
    if (thick_500_flag) call thick_500%write_field()
    if (snow_probability_flag) call snow_probability%write_field()

    ! Clean up.
    if (allocated(plevs)) then
      deallocate(plevs)
    end if

  end subroutine from_plev_geopot


  !> @brief Calculate and write horizontal divergence on pressure levels.
  !> @param[in]     wind              3D wind field on W2
  !> @param[in]     exner_w3          Exner pressure on W3
  !> @param[in]     main_mesh         Primary mesh pointer
  !> @param[in]     element_order_h   Element order in the horizontal
  !> @param[in]     element_order_v   Element order in the vertical
  subroutine write_horizontal_divergence_diagnostic( &
          wind, exner_w3, main_mesh, element_order_h, element_order_v)

    implicit none

    ! Arguments
    type(field_type),    intent(in)          :: wind
    type(field_type),    intent(in)          :: exner_w3
    type(mesh_type),     intent(in), pointer :: main_mesh
    integer(kind=i_def), intent(in)          :: element_order_h, element_order_v

    ! Locals
    type(field_type)                         :: wind_h, wind_v
    type(field_type)                         :: div_ml, div_pl
    type(r_tran_operator_type), pointer      :: div_op_r_tran
    type(operator_type)                      :: div_op

    type(integer_field_type), pointer        :: face_selector_ew
    type(integer_field_type), pointer        :: face_selector_ns

    integer(i_def)                           :: nplev
    real(r_def), allocatable                 :: plevs(:)
    logical(l_def)                           :: div_flag


    ! Has this diagnostic been requested for this timestep?
    div_flag = init_diag(div_pl, 'aviation__uv_wind_divergence')
    if (.not. div_flag) return

    ! Get the horizontal div operator matrix for this mesh.
    ! We get transport precision because there's no r_def version.
    div_op_r_tran => get_directional_im3_div_r_tran( wind%get_mesh_id(), &
                                                     direction_h )

    ! Convert the operator to r_def precision.
    call div_op%initialise( div_op_r_tran%get_fs_to(), &
                            div_op_r_tran%get_fs_from() )
    call invoke( operator_setval_x_kernel_type( div_op, div_op_r_tran ) )

    ! Split the 3d wind into horizontal and vertical components.
    face_selector_ew => get_face_selector_ew(wind%get_mesh())
    face_selector_ns => get_face_selector_ns(wind%get_mesh())

    call wind_h%initialise( function_space_collection%get_fs( &
        main_mesh, element_order_h, element_order_v, W2h ))
    call wind_v%initialise( function_space_collection%get_fs( &
        main_mesh, element_order_h, element_order_v, W2v ))

    call invoke( split_w2_field_kernel_type( &
        wind_h, wind_v, wind, face_selector_ew, face_selector_ns ))


    ! Multiply the wind by the div operator matrix to get the div.
    call div_ml%initialise( function_space_collection%get_fs( &
        main_mesh, element_order_h, element_order_v, W3 ))
    call invoke(dg_matrix_vector_kernel_type(div_ml, wind_h, div_op))

    ! Units are s**-1, for convenience scaled by 1.0E6
    ! (see UM's STASHmaster-meta.conf, code 20005).
    call invoke(inc_a_times_X(1.0e6_r_def, div_ml))


    ! Convert from model levels to pressure levels.
    nplev = get_axis_dimension('pressure_levels_xi3')
    allocate(plevs(nplev))
    plevs = get_axis_values('pressure_levels_xi3', nplev)
    call invoke_pres_interp_kernel_type(div_ml, exner_w3, nplev, plevs, &
                                        div_pl, p_zero, kappa)

    ! Write and clean up.
    call div_pl%write_field()
    deallocate(plevs)

  end subroutine write_horizontal_divergence_diagnostic

  !> @brief Calculate and write CAPE and CIN of undilute parcel ascents.
  !> @details Parcels are lifted from a 500 m deep mixed layer and from
  !>          screen level using the state at the end of the timestep. The
  !>          screen-level temperature and humidity are those kept by the
  !>          boundary layer scheme earlier in the timestep.
  !> @param[in] config         Model configuration
  !> @param[in] theta          Potential temperature
  !> @param[in] mr             Mixing ratios
  !> @param[in] exner_w3       Exner pressure on W3
  !> @param[in] rho            Dry density on W3
  !> @param[in] derived_fields Collection of derived fields
  !> @param[in] surface_fields Collection of surface fields
  subroutine write_cape_cin_diagnostics(config, theta, mr, exner_w3, rho,   &
                                        derived_fields, surface_fields)

    implicit none

    ! Arguments
    type(config_type),           intent(in) :: config
    type(field_type),            intent(in) :: theta
    type(field_type),            intent(in) :: mr(:)
    type(field_type),            intent(in) :: exner_w3
    type(field_type),            intent(in) :: rho
    type(field_collection_type), intent(in) :: derived_fields
    type(field_collection_type), intent(in) :: surface_fields

    ! Locals
    type(field_type) :: ml_cape, ml_cin, ml_equilibrium_height
    type(field_type) :: sb_cape, sb_cin

    type(field_type), pointer :: exner_in_wth
    type(field_type), pointer :: wetrho_in_w3
    type(field_type), pointer :: height_wth
    type(field_type), pointer :: height_w3
    type(field_type), pointer :: t1p5m_for_diags
    type(field_type), pointer :: q1p5m_for_diags
    type(mesh_type),  pointer :: mesh

    logical(l_def) :: ml_cape_flag, ml_cin_flag, ml_equilibrium_height_flag
    logical(l_def) :: sb_cape_flag, sb_cin_flag

    ! Have any of these diagnostics been requested for this timestep?
    ml_cape_flag = init_diag(ml_cape, 'convection__mixed_layer_cape')
    ml_cin_flag  = init_diag(ml_cin,  'convection__mixed_layer_cin')
    ml_equilibrium_height_flag = init_diag(ml_equilibrium_height,           &
        'convection__mixed_layer_equilibrium_height')
    sb_cape_flag = init_diag(sb_cape, 'convection__surface_based_cape')
    sb_cin_flag  = init_diag(sb_cin,  'convection__surface_based_cin')

    if ( .not. ( ml_cape_flag .or. ml_cin_flag .or.                         &
                 ml_equilibrium_height_flag .or.                            &
                 sb_cape_flag .or. sb_cin_flag ) ) return

    call derived_fields%get_field('exner_in_wth', exner_in_wth)
    mesh => theta%get_mesh()
    height_wth => get_height_fv(config, mesh, Wtheta)
    height_w3  => get_height_fv(config, mesh, W3)

    ! Parcel from a near-surface mixed layer.
    if ( ml_cape_flag .or. ml_cin_flag .or. ml_equilibrium_height_flag ) then
      call derived_fields%get_field('wetrho_in_w3', wetrho_in_w3)
      call invoke( cape_cin_mixed_layer_kernel_type(                        &
                       theta, mr(imr_v), exner_in_wth, height_wth,          &
                       exner_w3, rho, wetrho_in_w3, height_w3,              &
                       ml_cape, ml_cin, ml_equilibrium_height,              &
                       gravity, rd, cp, kappa, one_over_kappa, p_zero,      &
                       epsilon ) )
      if (ml_cape_flag) call ml_cape%write_field()
      if (ml_cin_flag)  call ml_cin%write_field()
      if (ml_equilibrium_height_flag)                                       &
          call ml_equilibrium_height%write_field()
    end if

    ! Parcel from screen level.
    if ( sb_cape_flag .or. sb_cin_flag ) then
      if ( boundary_layer /= boundary_layer_um .or.                         &
           surface /= surface_jules ) then
        call log_event( 'CAPE and CIN of surface parcels need the '//       &
                        'screen-level temperature and humidity from the '// &
                        'UM boundary layer and JULES: remove '//            &
                        'convection__surface_based_cape and '//             &
                        'convection__surface_based_cin from the output '//  &
                        'request or enable both schemes',                   &
                        log_level_error )
      end if
      call surface_fields%get_field('t1p5m_for_diags', t1p5m_for_diags)
      call surface_fields%get_field('q1p5m_for_diags', q1p5m_for_diags)
      call invoke( cape_cin_surface_kernel_type(                            &
                       theta, mr(imr_v), exner_in_wth, height_wth,          &
                       height_w3, t1p5m_for_diags, q1p5m_for_diags,         &
                       sb_cape, sb_cin,                                     &
                       gravity, rd, cp, kappa, one_over_kappa, p_zero,      &
                       epsilon ) )
      if (sb_cape_flag) call sb_cape%write_field()
      if (sb_cin_flag)  call sb_cin%write_field()
    end if

  end subroutine write_cape_cin_diagnostics

end module aviation_diags_alg_mod
