!-----------------------------------------------------------------------------
!> @brief Clear-air turbulence potential on pressure levels, including
!>        turbulence from mountain waves.

module clear_air_turb_pot_alg_mod

  use base_mesh_config_mod,        only: geometry, geometry_spherical
  use config_mod,                  only: config_type
  use constants_mod,               only: r_def, i_def, l_def, rmdi
  use extrusion_config_mod,        only: planet_radius
  use field_collection_mod,        only: field_collection_type
  use field_mod,                   only: field_type
  use fs_continuity_mod,           only: W3
  use initialise_diagnostics_mod,  only: init_diag => init_diagnostic_field
  use lfric_xios_diag_mod,         only: get_axis_dimension, get_axis_values
  use log_mod,                     only: log_event, log_level_error
  use mesh_mod,                    only: mesh_type
  use planet_config_mod,           only: p_zero, kappa
  use sci_geometric_constants_mod, only: get_height_fv, get_latitude_fv, &
                                         get_longitude_fv
  use science_conversions_mod,     only: seconds_per_hour
  use section_choice_config_mod,   only: orographic_drag, orographic_drag_um

  use ellrod_cat_kernel_mod,           only: ellrod_cat_kernel_type
  use mountain_wave_pot_kernel_mod,    only: mountain_wave_pot_kernel_type
  use mountain_wave_stress_kernel_mod, only: mountain_wave_stress_kernel_type
  use plev_wind_shear_kernel_mod,      only: plev_wind_shear_kernel_type

  implicit none

  private
  public :: clear_air_turb_pot_alg

  !> Mountain waves are included up to this time from the start of the run
  real(kind=r_def), parameter :: mountain_wave_time_limit =                 &
                                 24.0_r_def * seconds_per_hour
  !> Mountain waves are included on pressure levels at or above this
  !> height, given as a pressure (Pa)
  real(kind=r_def), parameter :: mountain_wave_press_limit = 30000.0_r_def
  !> Depth of the horizontal stencils
  integer(kind=i_def), parameter :: stencil_depth = 1_i_def

contains

  !> @brief   Clear-air turbulence potential on pressure levels.
  !> @details On each pressure level, the probability of clear-air
  !>          turbulence from Ellrod's first index is combined with a
  !>          mountain-wave turbulence predictor from the orographic drag
  !>          stress, by taking the larger of the two. Mountain waves are
  !>          included on levels at or above 300 hPa, for the first 24
  !>          hours of the run, and only when the orographic drag scheme is
  !>          on.
  !> @param[in] config           Application configuration object
  !> @param[in] derived_fields   Group of derived fields
  !> @param[in] orography_fields Fields for the orographic drag scheme
  !> @param[in] exner_w3         Exner pressure on W3 levels
  !> @param[in] twod_mesh        Two-dimensional mesh
  !> @param[in] time_since_start Time since the start of the run (s)
  subroutine clear_air_turb_pot_alg(config, derived_fields,              &
                                    orography_fields, exner_w3,          &
                                    twod_mesh, time_since_start)

    implicit none

    type(config_type),           intent(in) :: config
    type(field_collection_type), intent(in) :: derived_fields
    type(field_collection_type), intent(in) :: orography_fields
    type(field_type),            intent(in) :: exner_w3
    type(mesh_type), pointer,    intent(in) :: twod_mesh
    real(kind=r_def),            intent(in) :: time_since_start

    ! Output field and its request flag
    type(field_type) :: turb_pot
    logical(kind=l_def) :: turb_pot_flag

    ! Work fields on pressure levels
    type(field_type) :: u_plev, v_plev, wind_shear, cat_prob, stress_plev

    type(field_type), pointer :: u_in_w3, v_in_w3, exner_wth
    type(field_type), pointer :: taux_orog, tauy_orog
    type(field_type), pointer :: height_w3, latitude, longitude
    type(mesh_type),  pointer :: mesh

    integer(kind=i_def) :: nplev, kp
    real(kind=r_def), allocatable :: plevs(:)
    real(kind=r_def)    :: press_lev

    nullify( u_in_w3, v_in_w3, exner_wth, taux_orog, tauy_orog, &
             height_w3, latitude, longitude, mesh )

    turb_pot_flag = init_diag(turb_pot, 'aviation__clear_air_turb_pot')
    if ( .not. turb_pot_flag ) return

    ! The horizontal derivatives need the latitude and longitude of cells
    if ( geometry /= geometry_spherical ) then
      call log_event( 'Clear-air turbulence potential needs a spherical ' // &
                      'mesh', log_level_error )
    end if

    nplev = get_axis_dimension('pressure_levels')
    if ( nplev <= 0 ) then
      call log_event( 'Clear-air turbulence potential: no pressure levels', &
                      log_level_error )
    end if
    allocate( plevs(nplev) )
    plevs = get_axis_values('pressure_levels', nplev)

    call derived_fields%get_field('u_in_w3', u_in_w3)
    call derived_fields%get_field('v_in_w3', v_in_w3)
    mesh => exner_w3%get_mesh()
    height_w3 => get_height_fv(config, mesh, W3)
    latitude  => get_latitude_fv(config, twod_mesh, W3)
    longitude => get_longitude_fv(config, twod_mesh, W3)

    call turb_pot%copy_field_properties(u_plev)
    call turb_pot%copy_field_properties(v_plev)
    call turb_pot%copy_field_properties(wind_shear)
    call turb_pot%copy_field_properties(cat_prob)
    call turb_pot%copy_field_properties(stress_plev)

    ! Winds and vertical wind shear on each pressure level
    do kp = 1, nplev
      press_lev = plevs(kp)
      call invoke( plev_wind_shear_kernel_type(u_in_w3, v_in_w3,          &
                                               exner_w3, height_w3,       &
                                               u_plev, v_plev,            &
                                               wind_shear, press_lev, kp, &
                                               p_zero, kappa) )
    end do

    ! Clear-air turbulence probability. The stress is missing data on
    ! levels without a mountain-wave predictor.
    call invoke( ellrod_cat_kernel_type(cat_prob,                         &
                                        u_plev, stencil_depth,            &
                                        v_plev, stencil_depth,            &
                                        wind_shear,                       &
                                        latitude, stencil_depth,          &
                                        longitude, stencil_depth,         &
                                        nplev, planet_radius),            &
                 setval_c(stress_plev, rmdi) )

    ! Orographic drag stress on the pressure levels with mountain waves
    if ( orographic_drag == orographic_drag_um .and.                       &
         time_since_start <= mountain_wave_time_limit ) then
      call orography_fields%get_field('taux_orog_total', taux_orog)
      call orography_fields%get_field('tauy_orog_total', tauy_orog)
      call derived_fields%get_field('exner_in_wth', exner_wth)
      do kp = 1, nplev
        press_lev = plevs(kp)
        if ( press_lev <= mountain_wave_press_limit ) then
          call invoke( mountain_wave_stress_kernel_type(taux_orog,        &
                                                        tauy_orog,        &
                                                        exner_wth,        &
                                                        stress_plev,      &
                                                        press_lev, kp,    &
                                                        p_zero, kappa) )
        end if
      end do
    end if

    ! Combine with the mountain-wave predictor
    call invoke( mountain_wave_pot_kernel_type(turb_pot,                  &
                                               stress_plev, stencil_depth, &
                                               u_plev, stencil_depth,     &
                                               v_plev, stencil_depth,     &
                                               cat_prob,                  &
                                               latitude, stencil_depth,   &
                                               longitude, stencil_depth,  &
                                               nplev) )

    call turb_pot%write_field()

    deallocate( plevs )
    nullify( u_in_w3, v_in_w3, exner_wth, taux_orog, tauy_orog, &
             height_w3, latitude, longitude, mesh )

  end subroutine clear_air_turb_pot_alg

end module clear_air_turb_pot_alg_mod
