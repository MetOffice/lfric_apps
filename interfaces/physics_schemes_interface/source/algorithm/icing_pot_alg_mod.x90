!> @brief Holds code to calculate and output the icing-potential diagnostic.

module icing_pot_alg_mod

  use field_mod,               only: field_type
  use field_collection_mod,    only: field_collection_type
  use io_config_mod,           only: use_xios_io
  use constants_mod,           only: r_def, l_def, i_def
  use initialise_diagnostics_mod, only: init_diag => init_diagnostic_field
  use mr_indices_mod,          only: nummr, imr_v
  use lfric_xios_diag_mod,     only: get_axis_dimension, get_axis_values
  use planet_config_mod,       only: p_zero, kappa

  implicit none
  private

  public :: icing_pot_alg

contains

  !> @brief   Calculate and output the icing-potential diagnostic on pressure
  !!          levels.
  !> @details The icing potential is the relative humidity (capped at
  !!          saturation) retained only where cloud is present and the
  !!          temperature lies between 0 and -20 degrees Celsius. Relative
  !!          humidity, temperature and bulk cloud fraction are each
  !!          interpolated onto pressure levels before the masks are applied.
  !> @param[in] exner         Exner pressure in wth space
  !> @param[in] theta         Potential temperature
  !> @param[in] mr            Mixing ratios
  !> @param[in] cloud_fields  Collection holding the bulk cloud fraction
  subroutine icing_pot_alg(exner, theta, mr, cloud_fields)

    use msat_kernel_mod,      only: msat_kernel_type
    use psykal_lite_phys_mod, only: invoke_pres_interp_kernel_type, &
                                    invoke_icing_pot_kernel_type

    implicit none

    ! Arguments
    type( field_type ), intent(in) :: exner
    type( field_type ), intent(in) :: theta
    type( field_type ), intent(in) :: mr(nummr)
    type( field_collection_type ), intent(in) :: cloud_fields

    ! Bulk cloud fraction retrieved from the cloud collection
    type( field_type ), pointer :: cf_bulk => null()

    ! Model-level intermediates
    type( field_type ) :: msat_water, rh_water, temp
    ! Pressure-level intermediates and output
    type( field_type ) :: plev_icing_pot, plev_rh, plev_temp, plev_cf

    logical(l_def) :: water_only, plev_icing_pot_flag
    integer(i_def) :: nplev
    real(r_def), allocatable :: plevs(:)

    nplev = get_axis_dimension('pressure_levels')
    allocate(plevs(nplev))
    plevs = get_axis_values('pressure_levels', nplev)

    plev_icing_pot_flag = init_diag(plev_icing_pot, 'plev__icing_pot')
    if (plev_icing_pot_flag .and. use_xios_io) then

      call cloud_fields%get_field('bulk_fraction', cf_bulk)

      ! Create model-level intermediates matching the wth-space inputs
      call theta%copy_field_properties(msat_water)
      call theta%copy_field_properties(rh_water)
      call theta%copy_field_properties(temp)

      ! Relative humidity over water as a 0-1 fraction, and temperature, on
      ! model levels
      water_only = .true.
      call invoke(msat_kernel_type(msat_water, exner, theta, water_only), &
                  X_divideby_Y(rh_water, mr(imr_v), msat_water),          &
                  X_times_Y(temp, theta, exner) )

      ! Create pressure-level intermediates matching the registered output
      call plev_icing_pot%copy_field_properties(plev_rh)
      call plev_icing_pot%copy_field_properties(plev_temp)
      call plev_icing_pot%copy_field_properties(plev_cf)

      ! Interpolate each input onto pressure levels
      call invoke_pres_interp_kernel_type(rh_water, exner,      &
                                          nplev, plevs, plev_rh, &
                                          p_zero, kappa)
      call invoke_pres_interp_kernel_type(temp, exner,           &
                                          nplev, plevs, plev_temp, &
                                          p_zero, kappa)
      call invoke_pres_interp_kernel_type(cf_bulk, exner,      &
                                          nplev, plevs, plev_cf, &
                                          p_zero, kappa)

      ! Combine into the icing-potential index and output
      call invoke_icing_pot_kernel_type(plev_icing_pot, plev_rh, &
                                        plev_temp, plev_cf, nplev)
      call plev_icing_pot%write_field()

    end if

    deallocate(plevs)

  end subroutine icing_pot_alg

end module icing_pot_alg_mod
