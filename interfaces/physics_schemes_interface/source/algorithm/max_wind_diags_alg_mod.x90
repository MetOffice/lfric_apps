!> @brief Wind, pressure and ICAO height of the maximum wind, and ICAO
!>        heights of the base and top of the jet around it.

module max_wind_diags_alg_mod

  use constants_mod,              only: l_def
  use empty_data_mod,             only: empty_real_data
  use field_collection_mod,       only: field_collection_type
  use field_mod,                  only: field_type
  use icao_heights_kernel_mod,    only: icao_heights_kernel_type
  use initialise_diagnostics_mod, only: init_diag => init_diagnostic_field
  use max_wind_diags_kernel_mod,  only: max_wind_diags_kernel_type
  use planet_config_mod,          only: p_zero
  use planet_constants_mod,       only: g_over_r_def, recip_kappa_def

  implicit none

  private

  public :: max_wind_diags_alg

contains

  !> @brief Output the maximum wind diagnostics that are requested.
  !> @param[in] exner           Exner pressure in W3
  !> @param[in] derived_fields  Collection of derived fields
  subroutine max_wind_diags_alg(exner, derived_fields)

    implicit none

    type(field_type),            intent(in) :: exner
    type(field_collection_type), intent(in) :: derived_fields

    type(field_type)          :: max_wind_u, max_wind_v
    type(field_type)          :: max_wind_pressure, max_wind_icao
    type(field_type)          :: base_icao, top_icao
    type(field_type)          :: base_pressure, top_pressure
    type(field_type), pointer :: u_in_w3, v_in_w3
    logical(kind=l_def) :: max_wind_u_flag, max_wind_v_flag
    logical(kind=l_def) :: max_wind_pressure_flag, max_wind_icao_flag
    logical(kind=l_def) :: base_icao_flag, top_icao_flag

    nullify(u_in_w3, v_in_w3)

    max_wind_u_flag = init_diag(max_wind_u, 'aviation__max_wind_u')
    max_wind_v_flag = init_diag(max_wind_v, 'aviation__max_wind_v')
    ! The ICAO height is computed from the pressure, so requesting it
    ! activates the pressure
    max_wind_icao_flag = init_diag(max_wind_icao,                          &
                                   'aviation__max_wind_icao_height')
    max_wind_pressure_flag = init_diag(max_wind_pressure,                  &
                                       'aviation__max_wind_pressure',      &
                                       activate=max_wind_icao_flag)
    base_icao_flag = init_diag(base_icao,                                  &
                               'aviation__max_wind_base_icao_height')
    top_icao_flag = init_diag(top_icao, 'aviation__max_wind_top_icao_height')

    if ( .not. (max_wind_u_flag .or. max_wind_v_flag                       &
                .or. max_wind_pressure_flag .or. max_wind_icao_flag        &
                .or. base_icao_flag .or. top_icao_flag) ) return

    ! The base and top pressures are only needed for their ICAO heights,
    ! so they are local fields, left empty when that height is not
    ! requested
    if ( base_icao_flag ) then
      call base_icao%copy_field_properties(base_pressure,                  &
                                           name='max_wind_base_pressure')
    else
      call base_pressure%initialise(base_icao%get_function_space(),        &
                                    name='max_wind_base_pressure',         &
                                    override_data=empty_real_data)
    end if
    if ( top_icao_flag ) then
      call top_icao%copy_field_properties(top_pressure,                    &
                                          name='max_wind_top_pressure')
    else
      call top_pressure%initialise(top_icao%get_function_space(),          &
                                   name='max_wind_top_pressure',           &
                                   override_data=empty_real_data)
    end if

    call derived_fields%get_field('u_in_w3', u_in_w3)
    call derived_fields%get_field('v_in_w3', v_in_w3)

    call invoke( max_wind_diags_kernel_type(u_in_w3, max_wind_u,           &
                                            max_wind_v, max_wind_pressure, &
                                            base_pressure, top_pressure,   &
                                            v_in_w3,                       &
                                            exner, p_zero,                 &
                                            recip_kappa_def) )

    if ( max_wind_icao_flag ) then
      call invoke( icao_heights_kernel_type(max_wind_icao,                 &
                                            max_wind_pressure,             &
                                            g_over_r_def) )
      call max_wind_icao%write_field()
    end if
    if ( base_icao_flag ) then
      call invoke( icao_heights_kernel_type(base_icao, base_pressure,      &
                                            g_over_r_def) )
      call base_icao%write_field()
    end if
    if ( top_icao_flag ) then
      call invoke( icao_heights_kernel_type(top_icao, top_pressure,        &
                                            g_over_r_def) )
      call top_icao%write_field()
    end if

    if ( max_wind_u_flag ) call max_wind_u%write_field()
    if ( max_wind_v_flag ) call max_wind_v%write_field()
    if ( max_wind_pressure_flag ) call max_wind_pressure%write_field()

  end subroutine max_wind_diags_alg

end module max_wind_diags_alg_mod
