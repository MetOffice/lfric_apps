!-------------------------------------------------------------------------------
!> @brief Compute and output tropopause height, temperature, pressure and
!>        ICAO height

module tropopause_diags_alg_mod

  use config_mod,                  only: config_type
  use constants_mod,               only: l_def
  use field_mod,                   only: field_type
  use fs_continuity_mod,           only: Wtheta
  use initialise_diagnostics_mod,  only: init_diag => init_diagnostic_field
  use planet_config_mod,           only: p_zero, kappa
  use planet_constants_mod,        only: g_over_r_def
  use sci_geometric_constants_mod, only: get_height_fv
  use tropopause_diags_kernel_mod, only: tropopause_diags_kernel_type

  implicit none
  private

  public :: tropopause_diags_alg

contains

  !> @brief   Compute and output tropopause height, temperature, pressure
  !>          and ICAO height diagnostics.
  !> @param[in] config       Application namelist configuration object
  !> @param[in] theta        Potential temperature
  !> @param[in] exner_in_wth Exner pressure on Wtheta space
  subroutine tropopause_diags_alg(config, theta, exner_in_wth)

    implicit none

    type(config_type), intent(in) :: config
    type(field_type), intent(in) :: theta, exner_in_wth

    ! Local fields
    type(field_type) :: trop_ht, trop_temp, trop_press, trop_icao_ht
    type(field_type), pointer :: height_wth

    ! The kernel derives trop_temp from trop_ht, trop_press from trop_temp,
    ! and trop_icao_ht from trop_press: a one-way cascade, not a mutual
    ! dependency. Fields are initialised downstream-to-upstream so each
    ! field's own request flag can be folded into the activate= argument
    ! of the field it depends on - requesting a downstream field
    ! force-activates its upstream dependencies, never the reverse. The
    ! kernel checks each field's activation status directly
    ! (associated(..., empty_real_data)) to decide what to compute.
    logical(l_def) :: trop_ht_flag
    logical(l_def) :: trop_temp_flag
    logical(l_def) :: trop_press_flag
    logical(l_def) :: trop_icao_ht_flag

    nullify(height_wth)

    trop_icao_ht_flag = init_diag(trop_icao_ht, 'processed__trop_icao_ht')

    trop_press_flag = init_diag(trop_press, 'processed__trop_press', &
                                 activate=trop_icao_ht_flag)

    trop_temp_flag = init_diag(trop_temp, 'processed__trop_temp', &
                                activate=(trop_press_flag .or. &
                                          trop_icao_ht_flag))

    trop_ht_flag = init_diag(trop_ht, 'processed__trop_ht', &
                              activate=(trop_temp_flag .or. &
                                        trop_press_flag .or. trop_icao_ht_flag))

    ! Writes stay inside this guard so that a field is never written unless
    ! the kernel actually filled it.
    if (trop_ht_flag .or. trop_temp_flag .or. trop_press_flag .or. &
        trop_icao_ht_flag) then

      height_wth => get_height_fv(config, theta%get_mesh(), Wtheta)

      call invoke( tropopause_diags_kernel_type(theta, exner_in_wth,       &
                                                 height_wth,               &
                                                 trop_ht, trop_temp,       &
                                                 trop_press, trop_icao_ht, &
                                                 p_zero, kappa,            &
                                                 g_over_r_def) )

      if (trop_ht_flag)      call trop_ht%write_field()
      if (trop_temp_flag)    call trop_temp%write_field()
      if (trop_press_flag)   call trop_press%write_field()
      if (trop_icao_ht_flag) call trop_icao_ht%write_field()

    end if

  end subroutine tropopause_diags_alg

end module tropopause_diags_alg_mod
