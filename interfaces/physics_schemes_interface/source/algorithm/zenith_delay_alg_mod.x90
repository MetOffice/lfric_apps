!> @brief Code to calculate and output the zenith total delay

module zenith_delay_alg_mod

  use config_mod,                  only: config_type
  use constants_mod,               only: r_def
  use field_mod,                   only: field_type
  use io_config_mod,               only: use_xios_io
  use initialise_diagnostics_mod,  only: init_diag => init_diagnostic_field
  use mr_indices_mod,              only: nummr, imr_v
  use moist_dyn_mod,               only: num_moist_factors, total_mass
  use planet_constants_mod,        only: p_zero, recip_kappa_def, r, g,    &
                                         grcp, c_virtual, repsilon
  use sci_geometric_constants_mod, only: get_height_fv
  use fs_continuity_mod,           only: Wtheta, W3

  implicit none

  private

  public :: zenith_delay_alg

contains

  !> @brief   Output diagnostic of zenith total delay
  !> @details Port of the UM PWS diagnostic (STASH m01s20i060). The whole
  !>          calculation is done inside the request guard, in a single
  !>          column kernel.
  !> @param[in]  config     Application namelist configuration object
  !> @param[in]  exner_w3   Exner pressure in W3 space
  !> @param[in]  exner_wth  Exner pressure in Wtheta space
  !> @param[in]  mr         Mixing ratios
  !> @param[in]  moist_dyn  Moist dynamics factors
  subroutine zenith_delay_alg(config, exner_w3, exner_wth, mr, moist_dyn)

    use zenith_delay_kernel_mod, only: zenith_delay_kernel_type

    implicit none

    ! Arguments
    type(config_type), intent(in) :: config

    type( field_type ), intent(in) :: exner_w3
    type( field_type ), intent(in) :: exner_wth
    type( field_type ), intent(in) :: mr(nummr)
    type( field_type ), intent(in) :: moist_dyn(num_moist_factors)

    ! Local fields
    type( field_type )          :: zenith_total_delay
    type( field_type ), pointer :: height_w3
    type( field_type ), pointer :: height_wth

    ! Planet constants converted to the kind expected by the kernel
    real(kind=r_def) :: p_zero_in, r_in, g_in
    real(kind=r_def) :: grcp_in, c_virtual_in, repsilon_in

    nullify(height_w3, height_wth)

    if (init_diag(zenith_total_delay, 'processed__zenith_total_delay')     &
        .and. use_xios_io) then

      height_w3  => get_height_fv(config, exner_w3%get_mesh(), W3)
      height_wth => get_height_fv(config, exner_wth%get_mesh(), Wtheta)

      p_zero_in    = real(p_zero, r_def)
      r_in         = real(r, r_def)
      g_in         = real(g, r_def)
      grcp_in      = real(grcp, r_def)
      c_virtual_in = real(c_virtual, r_def)
      repsilon_in  = real(repsilon, r_def)

      call invoke( zenith_delay_kernel_type(exner_w3, exner_wth,           &
                                            mr(imr_v),                     &
                                            moist_dyn(total_mass),         &
                                            height_w3, height_wth,         &
                                            p_zero_in, recip_kappa_def,    &
                                            r_in, g_in, grcp_in,           &
                                            c_virtual_in, repsilon_in,     &
                                            zenith_total_delay) )
      call zenith_total_delay%write_field()

    end if

  end subroutine zenith_delay_alg

end module zenith_delay_alg_mod
