! -----------------------------------------------------------------------
!> @brief Module providing an interface with the UKCA diagnostics handling
!         system.
!
! Method:
!
!   The following public subroutines are provided.
!
!   initialise_ukca_diagnostics - Passes to UKCA the information on diagnostic
!                                 requests active in the current call.
!   output_ukca_diagnostics     - Output the chemistry diagnostics active in
!                                 current call.
!
! ----------------------------------------------------------------------

module ukca_diags_interface_mod

use ukca_diag_setup_mod,   only: nm_rxnflux_oh_ch4_trop,                       &
                                 nm_o3_column_du,                              &
                                 key_diagname_base

use photol_diags_kernel_mod,  only: photol_diags_kernel_type

use ukca_api_mod, only :   ukca_maxlen_diagname, ukca_maxlen_message,          &
                           ukca_update_diagnostic_requests,                    &
                           ukca_diag_status_inactive,                          &
                           ukca_diag_status_requested

use initialise_diagnostics_mod,  only: init_diag => init_diagnostic_field

use key_value_collection_mod,    only: key_value_collection_type
use constants_mod, only : i_def, r_def, l_def, str_def, i_um
use field_mod,            only: field_type
use log_mod,       only : log_scratch_space, log_event, LOG_LEVEL_ERROR,    & 
                          LOG_LEVEL_DEBUG

implicit none

private

public :: initialise_ukca_diagnostics, output_ukca_diagnostics

contains

! ----------------------------------------------------------------------
subroutine initialise_ukca_diagnostics(                                        &
                                        values,                                &
                                        l_chem_timestep,                       &
                                        n_req_ukca_diags_3d,                   &
                                        idiag_status_3d,                       &
                                        ukca_req_diagnames_fullht,             &
                                        rxnflux_oh_ch4_trop,                   &
                                        o3_column_du                           &                                      
                                      )
! ----------------------------------------------------------------------
! Description:
!   Set up the list of active diagnostics to be passed to UKCA
!   Requirement of diagnostic is determined by call to init_diag which
!   in turn queries XIOS to check if field is to be sampled this timestep
! ----------------------------------------------------------------------
implicit none

type(key_value_collection_type), intent(in) :: values
logical(l_def), intent(in)  :: l_chem_timestep
integer(i_def), intent(out) :: n_req_ukca_diags_3d
integer(i_def), allocatable, intent(out) :: idiag_status_3d(:)
character(len=ukca_maxlen_diagname), allocatable, intent(out) ::               &
                               ukca_req_diagnames_fullht(:)
type(field_type), intent(inout) :: rxnflux_oh_ch4_trop
type(field_type), intent(inout) :: o3_column_du

! Local variables
integer(i_def) :: n
logical :: l_diag_requested
character(len=ukca_maxlen_diagname) :: diagname_key
! Pointers to extract data from key_value dictionary.
integer(i_def), pointer :: ptr_n_req_diags
character(len=ukca_maxlen_diagname), pointer :: ptr_ukca_diagname

! Error handling variables
integer(i_um) :: errcode
character(len=ukca_maxlen_message) :: ukca_errmsg

! End of header

errcode = 0_i_um

nullify(ptr_n_req_diags)
nullify(ptr_ukca_diagname)

! Extract key values and names from database
! If main n_req key is not found, the ukca_diag_setup routine was not called
! (or failed with warning), so allocate minimal size to arrays
if ( .not. values%key_value_exists('n_req_ukca_diags_3d') ) then
  n_req_ukca_diags_3d = 0
  allocate(ukca_req_diagnames_fullht(0))
  allocate(idiag_status_3d(0))
  return
end if
call values%get_value('n_req_ukca_diags_3d', ptr_n_req_diags)
n_req_ukca_diags_3d = ptr_n_req_diags
allocate(ukca_req_diagnames_fullht(n_req_ukca_diags_3d))
! Currently diagnames are stored as individual keys
do n = 1, n_req_ukca_diags_3d
  write(diagname_key, '(A,I0)') trim(key_diagname_base), n
  call values%get_value( diagname_key, ptr_ukca_diagname )
  ukca_req_diagnames_fullht(n) = ptr_ukca_diagname
end do
allocate(idiag_status_3d(n_req_ukca_diags_3d))

! Determine if any requested UKCA diagnostics are active for this call.
!
! Some diagnostics will not be calculated on non-chemistry steps,
! so deactivate automatically
do n = 1, n_req_ukca_diags_3d
  l_diag_requested = .false.
  select case (trim(ukca_req_diagnames_fullht(n)))
    case (trim(nm_rxnflux_oh_ch4_trop))
      l_diag_requested = init_diag(rxnflux_oh_ch4_trop,           &
                            'chemistry__'//nm_rxnflux_oh_ch4_trop)  
      if ( .not. l_chem_timestep ) l_diag_requested = .false.
    case (trim(nm_o3_column_du))
      l_diag_requested = init_diag(o3_column_du,'chemistry__'//nm_o3_column_du)
    case default
      call log_event(                                                          &
        'INIT_UKCA_DIAGS: Unrecognised :'//trim(ukca_req_diagnames_fullht(n)), &
        LOG_LEVEL_ERROR )
  end select
  if (l_diag_requested) then
    idiag_status_3d(n) = ukca_diag_status_requested
    write(log_scratch_space, '(A,A)')'UKCA ACTIVE diagnostic : ', &
          trim(ukca_req_diagnames_fullht(n))
    call log_event(log_scratch_space, LOG_LEVEL_DEBUG)
  else
    idiag_status_3d(n) = ukca_diag_status_inactive  
  end if  
end do

! Update the diagnostic request information in UKCA via API call
if ( n_req_ukca_diags_3d > 0 ) then
  call ukca_update_diagnostic_requests(                                        &
         errcode,                                                              &
         dreq_status_fullht_real=idiag_status_3d,                              &
         error_message=ukca_errmsg )
  if (errcode > 0_i_um) then
    write(log_scratch_space,'(A,I0,A)')'Error in UKCA_UPDATE_DIAG_REQUESTS: ', &
      errcode, ': '//TRIM(ukca_errmsg)
    call log_event(log_scratch_space, LOG_LEVEL_ERROR)
  end if
end if

end subroutine initialise_ukca_diagnostics
! ----------------------------------------------------------------------

! ----------------------------------------------------------------------
subroutine output_ukca_diagnostics(                                            &
                                    n_req_ukca_diags_3d,                       &
                                    idiag_status_3d,                           &
                                    ukca_req_diagnames_fullht,                 &
                                    diagnostics_fullht_real,                   &
                                    rxnflux_oh_ch4_trop,                       &
                                    o3_column_du                               &
                                  )
               
implicit none

integer(i_def), intent(in) :: n_req_ukca_diags_3d
integer(i_def), allocatable, intent(in) :: idiag_status_3d(:)
character(len=ukca_maxlen_diagname), allocatable, intent(in) ::                &
                               ukca_req_diagnames_fullht(:)
type(field_type), intent(in) :: diagnostics_fullht_real

type(field_type), intent(inout) :: rxnflux_oh_ch4_trop
type(field_type), intent(inout) :: o3_column_du

integer(i_def) :: i

do i = 1, n_req_ukca_diags_3d
  select case (trim(ukca_req_diagnames_fullht(i)))
    case (trim(nm_rxnflux_oh_ch4_trop))
      if (idiag_status_3d(i) == ukca_diag_status_requested)  then
        call invoke (  photol_diags_kernel_type( rxnflux_oh_ch4_trop, i,       &
                                                diagnostics_fullht_real ) )
        call rxnflux_oh_ch4_trop % write_field
      end if  
    case (trim(nm_o3_column_du))
      if (idiag_status_3d(i) == ukca_diag_status_requested) then
        call invoke (  photol_diags_kernel_type( o3_column_du, i,              &
                                                diagnostics_fullht_real ) )
        call o3_column_du % write_field
      end if  
    case default
      write(log_scratch_space, '(A,A,A)')'OUTPUT_UKCA_DIAGS, Unrecognised ',   &
            trim(ukca_req_diagnames_fullht(i)),                                &
            '. Add new diagnostic write statements here.'
      call log_event(log_scratch_space, LOG_LEVEL_ERROR )
  end select
end do

end subroutine output_ukca_diagnostics
! ----------------------------------------------------------------------

end module ukca_diags_interface_mod
