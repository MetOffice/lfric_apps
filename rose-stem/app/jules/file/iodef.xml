<?xml version="1.0" encoding="UTF-8"?>
<simulation>

  <!-- In this version we have ONE context  -->

  <context id = "gungho_atm">

    <variable_definition src="../../lfric_atm/metadata/variable_def_main.xml"/>
    <axis_definition src="../../lfric_atm/metadata/axis_def_main.xml"/>
    <!-- Pressure level axes definitions -->
    <axis_definition>
      <axis id="pressure_levels" name="pressure_levels" n_glo="29" value="(0,28)[100000 95000 92500 90000 85000 70000 60000 50000 40000 30000 25000 20000 15000 10000 7000 5000 3000 2000 1000 700 500 300 200 100 70 50 30 20 10]"/>
      <axis id="pressure_levels_xi3" name="pressure_levels_xi3" n_glo="1" value="(0,0)[85000]"/>
      <!-- Time axis of the JULES site forcing file, sized from the file at run time -->
      <axis id="jules_forcing_time_axis" name="jules_forcing_time_axis" />
      <!-- Single point of the JULES site forcing file (no mesh information) -->
      <axis id="jules_forcing_point" name="land" n_glo="1" />
    </axis_definition>

    <domain_definition src="../../lfric_atm/metadata/domain_def_main.xml"/>
    <grid_definition src="../../lfric_atm/metadata/grid_def_main.xml"/>
    <grid_definition>
      <!-- JULES site forcing data: single point by time, matching (time, land) in the file -->
      <grid id="jules_forcing_grid">
        <axis axis_ref="jules_forcing_point"/>
        <axis axis_ref="jules_forcing_time_axis"/>
      </grid>
    </grid_definition>

    <field_definition src="../../lfric_atm/metadata/lfric_dictionary.xml"/>

    <field_definition src="../../lfric_atm/metadata/field_def_diags.xml"/>
    <field_definition src="../../lfric_atm/metadata/field_def_initial_diags.xml"/>
    <field_definition src="../../lfric_atm/metadata/field_def_lbc_diags.xml"/>

    <field_definition prec="8" >

      <!-- Checkpoint group -->
      <field_group id="checkpoint_fields" operation="once"  enabled=".FALSE." >
      </field_group>
    </field_definition>

    <!-- JULES site forcing file definition, which depends on the format of the forcing file -->
    <file_definition src="./file_def_jules_forcing.xml"/>

    <file_definition
	type="one_file"
	time_counter="none">

      <!-- Checkpoint groups -->

      <!-- File definition for checkpoint write -->
      <file id="lfric_checkpoint_write" name="lfric_checkpoint_write" output_freq="1ts" convention="CF" enabled=".FALSE.">
      </file>

      <!-- File definition for checkpoint read -->
      <file id="lfric_checkpoint_read" name="lfric_checkpoint_read" mode="read" output_freq="1ts" cyclic="true" enabled=".FALSE.">
      </file>

      <file id="lfric_diag" name="lfric_diag" output_freq="6h" convention="UGRID" enabled=".TRUE.">
	<field field_ref="u_in_w3" />
	<field field_ref="v_in_w3" />
	<field field_ref="processed__pstar" />
	<field field_ref="surface__tile_fraction" />
	<field field_ref="surface__z0m" />
	<field field_ref="surface__z0m_tile" />
	<field field_ref="surface__canopy_height" />
	<field field_ref="surface__leaf_area_index" />
	<field field_ref="surface__tile_temperature" />
	<field field_ref="surface__grid_surface_temperature" />
	<field field_ref="surface__t1p5m_surft" />
	<field field_ref="surface__t1p5m" />
	<field field_ref="surface__q1p5m_surft" />
	<field field_ref="surface__q1p5m" />
	<field field_ref="surface__rh1p5m" />
	<field field_ref="surface__tile_heat_flux" />
	<field field_ref="surface__tile_moisture_flux" />
	<field field_ref="surface__latent_heat" />
	<field field_ref="surface__grid_latent_heat" />
	<field field_ref="surface__canopy_water" />
	<field field_ref="surface__grid_canopy_water" />
	<field field_ref="surface__throughfall" />
	<field field_ref="surface__grid_throughfall" />
	<field field_ref="surface__canopy_evap" />
	<field field_ref="surface__grid_canopy_evap" />
	<field field_ref="surface__soil_evap" />
	<field field_ref="surface__surf_ht_flux" />
	<field field_ref="surface__soil_surf_ht_flux" />
	<field field_ref="surface__surf_sw_net" />
	<field field_ref="surface__surf_radnet" />
	<field field_ref="surface__surf_lw_up" />
	<field field_ref="surface__surf_lw_down" />
	<field field_ref="surface__gross_prim_prod" />
	<field field_ref="surface__net_prim_prod" />
	<field field_ref="surface__gc_tile" />
	<field field_ref="surface__soil_respiration" />
	<field field_ref="soil__surface_runoff" />
	<field field_ref="soil__sub_surface_runoff" />
	<field field_ref="soil__soil_moisture_content" />
	<field field_ref="soil__soil_moisture" />
	<field field_ref="soil__unfrozen_soil_moisture" />
	<field field_ref="soil__frozen_soil_moisture" />
	<field field_ref="soil__soil_temperature" />
	<field field_ref="soil__water_table" />
	<field field_ref="soil__soil_moist_wilt" />
	<field field_ref="soil__soil_moist_crit" />
	<field field_ref="soil__soil_moist_sat" />
      </file>

      <file id="lfric_initial" name="lfric_initial" output_freq="1ts" convention="UGRID" enabled=".TRUE.">
      </file>

      <!-- File definition for writing an FD dump -->
      <file id="lfric_fd_dump" name="lfric_fd_dump" output_freq="1ts" convention="UGRID" enabled=".FALSE." >
      </file>

      <!-- File definition for reading in from a UM2LFRic FD UGRID format dump  -->
      <file id="read_lfric_fd_dump" name="lfric_fd_dump" mode="read" output_freq="1ts" convention="UGRID" cyclic="false" enabled=".FALSE.">
      </file>

    </file_definition>

  </context>

  <context id = "xios">
    <variable_definition>
      <variable_group id = "buffer">
        <variable id = "optimal_buffer_size" type = "string" >performance</variable>
        <variable id = "buffer_size_factor" type = "double" >1.0</variable>
      </variable_group>

      <variable_group id = "parameters" >
        <variable id = "using_server" type = "bool" >true</variable>
        <variable id = "info_level" type = "int" >50</variable>
        <variable id = "print_file" type="bool">true</variable>
      </variable_group>
    </variable_definition>
  </context>

</simulation>
