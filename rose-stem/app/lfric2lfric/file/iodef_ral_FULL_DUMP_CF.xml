        <field id="checkpoint_screen_temperature" name="screen_temperature" long_name="screen_temperature_on_tiles" unit="K" prec="8" domain_ref="face" axis_ref="surface_tiles" operation="once" />
        <field id="checkpoint_time_since_transition" name="time_since_transition" long_name="time_since_decoupled_screen_transition" unit="s" prec="8" domain_ref="face" operation="once" />
        <field id="checkpoint_canopy_water" name="canopy_water" long_name="canopy_water_content_on_tiles" unit="kg m-2" prec="8" domain_ref="face" axis_ref="surface_tiles" operation="once" />
        <field id="checkpoint_sea_ice_thickness" name="sea_ice_thickness" long_name="sea_ice_thickness" unit="m" prec="8" domain_ref="face" axis_ref="sea_ice_categories" operation="once" />
