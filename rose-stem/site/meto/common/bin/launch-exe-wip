#!/usr/bin/env bash

set -euo pipefail

# Include statements
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/launcher_functions.sh"


function main () {
    # VALIDATION LISTS
    local BOOL_VALUES="True False"
    local VALID_PLATFORMS="meto-azspice meto-ex1a"
    local VALID_RUN_METHODS="executable mpiexec"
    local VALID_INTERLEAVING_METHODS="uniform"

    # 1. Set the default environment
    # ------------------------------
    utils::set_default_env

    # 2. Validate the environment
    # ---------------------------
    # List required env vars
    utils::validate_env

    # 3. Main work
    # ------------
    if [ "${INTERLEAVE_EXECS}" = "True" ]; then
        # Include the interleaving functions
        source "${SCRIPT_DIR}/interleaver/interleaving_functions.sh"
        # Generate interleaving configuration
        utils::interleave
    else
        # Set some derived variables
        utils::set_derived_vars

        # Work out the required ppn value
        utils::get_cores_per_node

        # Set the model launcher options
        utils::set_model_options

        # Set the XIOS launcher options
        utils::set_xios_options

        # Build the command from the component parts
        utils::build_exec_command
    fi

    # Test mode trap
    if [ "${TEST_MODE}" = 0 ] ; then
        if [ "${TEST_LAUNCH_EXE_EXEC}" = "${EXEC_COMMAND}" ] ; then
            test_error=0
        else
            test_error=1
            printf "LFRIC LAUNCHER TESTING ERROR: \n%s\n \t!= \n%s\n " "${TEST_LAUNCH_EXE_EXEC}" "${EXEC_COMMAND}" >&2
        fi
        exit ${test_error}
    fi

    # Run the command and capture the output
    echo Execute command is:
    echo ""
    echo ${EXEC_COMMAND}
    echo ""
    echo Running ...
    echo ""
    ${EXEC_COMMAND}

    # Capture the return value from running the command and throw an error if
    # the code is anything but 0
    ret_code=$?
    if [ ${ret_code} != 0 ] ; then
    echo "Execution failed, Error return code ${ret_code}."
    fi

    # Call memory profiling work (only works if requested and on suitable platform)
    utils::run_memory_profiler

    exit ${ret_code}
}

# Make sure we are actually calling the main function
main "$@"