#!/usr/bin/env bash

set -euo pipefail

# Include statements
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/launcher_functions.sh"


function main () {
    # VALIDATION LISTS
    local VALID_PLATFORMS="meto-azspice meto-ex1a"
    local VALID_RUN_METHODS="executable mpiexec"
    local BOOL_VALUES="True true False false"

    # Set the default environment
    utils::set_default_env

    # Validate the environment
    utils::validate_env

    # Work out the reuired ppn value
    utils::get_cores_per_node

    # Set the model launcher options
    utils::set_model_options

    # Set the XIOS launcher options
    utils::set_xios_options

    # Build the command from the component parts
    utils::build_exec_command

    # Run the command and capture the output
    echo Execute command is:
    echo ""
    echo ${EXEC_COMMAND}
    echo ""
    echo Running ...
    echo ""
    ${EXEC_COMMAND}

    # Capture the return value from running the command and throw an error if
    # the code is anything but 0
    ret_code=$?
    if [ ${ret_code} != 0 ] ; then
    echo "Execution failed, Error return code ${ret_code}."
    fi

    # Call memory profiling work (only works if requested and on suitable platform)
    utils::run_memory_profiler

    exit ${ret_code}
}

# Make sure we are actually calling the main function
main "$@"