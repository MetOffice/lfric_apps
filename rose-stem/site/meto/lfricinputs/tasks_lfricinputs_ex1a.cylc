{% do LOG.debug("Entered site/meto/lfricinputs/tasks_lfricinputs_ex1a.cylc") %}

{% if task_ns.conf_name == "lfric2um-umlam-C48L70_N512L70" %}

    {% do task_dict.update({
        "mpi_parts": 12,
    }) %}

{% elif task_ns.conf_name == "lfric2um-nwp_gal9-C224L70_N320L70" %}

    {% do task_dict.update({
        "memory": [54, "GB"],
        "mpi_parts": 12,
    }) %}

{% elif task_ns.conf_name == "lfric2um-nwp_gal9-C896L70_N320L70" %}

    {% do task_dict.update({
        "mpi_parts": 576,
        "wallclock": 30,
    }) %}

{% elif task_ns.conf_name == "lfric2um-nwp_gal9-C896L70_N1280L70" %}

    {% do task_dict.update({
        "mpi_parts": 768,
        "wallclock": 30,
    }) %}

{% elif task_ns.conf_name == "um2lfric-nwp_gal9-N320L70_C224L70" %}

    {% do task_dict.update({
        "memory": [54, "GB"],
        "mpi_parts": 12,
    }) %}

{% elif task_ns.conf_name == "um2lfric-nwp_gal9-N320L70_C896L70" %}

    {% do task_dict.update({
        "mpi_parts": 192,
    }) %}

{% elif task_ns.conf_name == "um2lfric-nwp_gal9-N1280L70_C224L70" %}

    {% do task_dict.update({
        "mpi_parts": 384,
    }) %}

{% elif task_ns.conf_name == "um2lfric-nwp_gal9-N1280L70_C896L70" %}

    {% do task_dict.update({
        "mpi_parts": 768,
    }) %}

{% endif %}

{% if task_dict %}
    {% if "mpi_parts" not in task_dict %}
        {% do task_dict.update({
            "mpi_parts": 126,
            "xproc": 9,
            "yproc": 14,
        }) %}
    {% endif %}
    {% if task_dict["app_name"] == "um2lfric" and task_ns.conf_name != "um2lfric-nwp_gal9-N320L70_C224L70" and task_ns.conf_name != "um2lfric-nwp_gal9-N320L70_C896L70" and task_ns.conf_name != "um2lfric-nwp_gal9-N1280L70_C224L70" and task_ns.conf_name != "um2lfric-nwp_gal9-N1280L70_C896L70"%}
        {% do task_dict.update({
            "xios_nodes": 1,
            "mpi_parts_xios": 1,
            "task_ranks_per_node": task_dict["mpi_parts"],
        }) %}
    {% endif %}
{% endif %}

{% do LOG.debug("Finished in site/meto/lfricinputs/tasks_lfricinputs_ex1a.cylc") %}
