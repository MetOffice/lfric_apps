{% do LOG.debug("Entered site/meto/macros/macros_azspice.cylc") %}

{% macro set_task_resources(family_name,
                            family_inherits,
                            wallclock,
                            mpi_ranks,
                            memory,
                            threads=1,
                            xios_nodes=0,
                            ocean_nodes=0,
                            river_nodes=0,
                            ranks_per_node=0,
                            ranks_depth_pad=1) %}

    [[{{family_name|upper}}]]
        inherit = {{family_inherits|upper}}
        execution time limit = PT{{wallclock}}M

        [[[directives]]]

    {{ set_memory(memory) }}
            --ntasks={{mpi_ranks|int + xios_nodes|int}}
            --cpus-per-task={{threads|int}}

{% endmacro %}


{% macro set_memory(mem) %}
    {% set value = mem[0]|int %}
    {% set unit = mem[1] %}
            --mem-per-cpu={{value}}{{unit[:1]}}
{% endmacro %}

{% do LOG.debug("Finished in site/meto/macros/macros_azspice.cylc") %}
