{% do LOG.debug("Entered site/meto/groups/groups_adjoint_tests.cylc") %}

{# asp2a Groups #}
{% do site_groups.update({
    "adjoint_tests_asp2a_developer": [
        "adjoint_tests_default-C12_asp2a_intel_fast-debug-64bit",
        "adjoint_tests_default-C12_asp2a_intel_full-debug-64bit",
        "adjoint_tests_asp2a_canned",
    ],
    "adjoint_tests_asp2a": [
        "adjoint_tests_asp2a_developer",
    ],
    "adjoint_tests_asp2a_canned": [
        "adjoint_tests_canned_asp2a_intel_fast-debug-64bit",
    ],
    "adjoint_tests_asp2a_build": [
        "build_adjoint_tests_asp2a_intel_fast-debug-64bit",
        "build_adjoint_tests_asp2a_intel_full-debug-64bit",
    ],
    })  %}

{# Platform Generic Groups #}
{% do site_groups.update({
    "adjoint_tests_developer": [
        "scripts",
        "adjoint_tests_asp2a_developer",
    ],
    "adjoint_tests": [
        "adjoint_tests_developer",
        "adjoint_tests_asp2a",
    ],
    "adjoint_tests_canned": [
        "adjoint_tests_asp2a_canned",
    ],
    "adjoint_tests_build": [
        "adjoint_tests_asp2a_build",
    ],
    }) %}

{# Platform Generic Extends #}
{% do site_groups.developer.extend(site_groups.adjoint_tests_developer) %}
{% do site_groups.all.extend(site_groups.adjoint_tests) %}
{% do site_groups.build.extend(site_groups.adjoint_tests_build) %}

{# asp2a Extends #}
{% do site_groups.asp2a_developer.extend(site_groups.adjoint_tests_asp2a_developer) %}
{% do site_groups.asp2a.extend(site_groups.adjoint_tests_asp2a) %}
{% do site_groups.asp2a_build.extend(site_groups.adjoint_tests_asp2a_build) %}

{% do LOG.debug("Finished in site/meto/groups/groups_adjoint_tests.cylc") %}
