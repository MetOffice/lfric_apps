{% do LOG.debug("Entered site/meto/groups/groups_gungho.cylc") %}

{# asp2a Groups #}
{% do site_groups.update({
    "gungho_asp2a_developer": [
        "gungho_asp2a_unit_tests",
        "gungho_asp2a_integration_tests",
    ],
    "gungho_asp2a": [
        "gungho_asp2a_developer",
    ],
    "gungho_asp2a_unit_tests": [
        "gungho_unit_tests_asp2a_intel_64bit",
    ],
    "gungho_asp2a_integration_tests": [
        "gungho_integration_tests_asp2a_intel_64bit",
    ],
    }) %}

{# Platform Generic Groups #}
{% do site_groups.update({
    "gungho_developer": [
        "scripts",
        "gungho_asp2a_developer",
        "gungho_unit_tests",
        "gungho_integration_tests",
    ],
    "gungho": [
        "gungho_developer",
        "gungho_asp2a",
    ],
    "gungho_unit_tests": [
        "gungho_asp2a_unit_tests",
    ],
    "gungho_integration_tests": [
        "gungho_asp2a_integration_tests",
    ],
    }) %}

{# Generic Extends #}
{% do site_groups.developer.extend(site_groups.gungho_developer) %}
{% do site_groups.all.extend(site_groups.gungho) %}
{% do site_groups.unit_tests.extend(site_groups.gungho_unit_tests) %}
{% do site_groups.integration_tests.extend(site_groups.gungho_integration_tests) %}

{# asp2a Extends #}
{% do site_groups.asp2a_developer.extend(site_groups.gungho_asp2a_developer) %}
{% do site_groups.asp2a.extend(site_groups.gungho_asp2a) %}
{% do site_groups.asp2a_unit_tests.extend(site_groups.gungho_asp2a_unit_tests) %}
{% do site_groups.asp2a_integration_tests.extend(site_groups.gungho_asp2a_integration_tests) %}

{% do LOG.debug("Finished in site/meto/groups/groups_gungho.cylc") %}
