{% do LOG.debug("Entered site/meto/groups/groups_jedi_lfric_interface.cylc") %}

{# asp2a Groups #}
{% do site_groups.update({
    "jedi_lfric_interface_asp2a_developer": [
        "jedi_lfric_interface_asp2a_unit_tests",
        "jedi_lfric_interface_asp2a_integration_tests",
    ],
    "jedi_lfric_interface_asp2a": [
        "jedi_lfric_interface_asp2a_developer",
    ],
    "jedi_lfric_interface_asp2a_unit_tests": [
        "jedi_lfric_interface_unit_tests_asp2a_intel_64bit",
    ],
    "jedi_lfric_interface_asp2a_integration_tests": [
        "jedi_lfric_interface_integration_tests_asp2a_intel_64bit",
    ],
    }) %}

{# Platform Generic Groups #}
{% do site_groups.update({
    "jedi_lfric_interface_developer": [
        "scripts",
        "jedi_lfric_interface_asp2a_developer",
        "jedi_lfric_interface_unit_tests",
        "jedi_lfric_interface_integration_tests",
    ],
    "jedi_lfric_interface": [
        "jedi_lfric_interface_developer",
        "jedi_lfric_interface_asp2a",
    ],
    "jedi_lfric_interface_unit_tests": [
        "jedi_lfric_interface_asp2a_unit_tests",
    ],
    "jedi_lfric_interface_integration_tests": [
        "jedi_lfric_interface_asp2a_integration_tests",
    ],
    }) %}

{# Generic Extends #}
{% do site_groups.developer.extend(site_groups.jedi_lfric_interface_developer) %}
{% do site_groups.all.extend(site_groups.jedi_lfric_interface) %}
{% do site_groups.unit_tests.extend(site_groups.jedi_lfric_interface_unit_tests) %}
{% do site_groups.integration_tests.extend(site_groups.jedi_lfric_interface_integration_tests) %}

{# asp2a Extends #}
{% do site_groups.asp2a_developer.extend(site_groups.jedi_lfric_interface_asp2a_developer) %}
