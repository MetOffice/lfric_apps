{% do site_groups.asp2a_unit_tests.extend(site_groups.jedi_lfric_interface_asp2a_unit_tests) %}
{% do site_groups.asp2a_integration_tests.extend(site_groups.jedi_lfric_interface_asp2a_integration_tests) %}

