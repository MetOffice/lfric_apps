!> @brief Computes the forcing from nudging to some external data.
module nudging_alg_mod

  ! Infrastructure
  use config_mod,                      only: config_type
  use constants_mod,                   only: i_def, l_def, r_def, str_def
  use extrusion_mod,                   only: TWOD
  use field_mod,                       only: field_type
  use field_collection_mod,            only: field_collection_type
  use fs_continuity_mod,               only: W3, Wtheta
  use function_space_mod,              only: function_space_type
  use function_space_collection_mod,   only: function_space_collection
  use integer_field_mod,               only: integer_field_type
  use log_mod,                         only: log_event, LOG_LEVEL_ERROR
  use mesh_mod,                        only: mesh_type
  use mesh_collection_mod,             only: mesh_collection
  use timing_mod,                      only: start_timing, stop_timing,        &
                                             tik, LPROF

  ! Configs
  use external_forcing_config_mod,     only: theta_forcing_nudging,            &
                                             wind_forcing_nudging
  use nudging_config_mod,              only: nudging_method_newtonian,         &
                                             nudging_method_convolution

  ! Kernels
  use convolution_2d_kernel_mod,       only: convolution_2d_kernel_type
  use newtonian_nudging_kernel_mod,    only: newtonian_nudging_kernel_type
  use nudging_ecmwf_vert_interp_kernel_mod,                                    &
                                       only: nudging_ecmwf_vert_interp_kernel_type
  use psykal_lite_mod,                 only: invoke_newtonian_nudging_kernel_type, &
                                             invoke_convolution_2d_kernel_type

  ! Other algorithms
  use intermesh_mappings_alg_mod,      only: map_scalar_intermesh,             &
                                             prolong_scalar_simple

  ! Getters to runtime constants
  use physics_constants_mod,           only: get_convolution_weights,          &
                                             get_nudging_weights

  implicit none

  private
  public :: nudging_alg
  public :: compute_nudging_spinup_factor
  public :: set_nudging_trop_level
  public :: set_nudging_reference_fields

contains

  !> @details Computes the increment associated with nudging the spectrum of a
  !!          field towards that of a reference field.
  !> @param[in]     config     Application namelist configuration object
  !> @param[in,out] increment  Increment field to be computed
  !> @param[in]     field_in   Input field to be nudged
  !> @param[in]     field_ref  Reference field to nudge towards
  subroutine nudging_alg(config, increment, field_in, field_ref,               &
                         time_weight, tropopause_level)

    use multires_coupling_config_mod, only: recovery_order_linear

    implicit none

    type(config_type),        intent(in)    :: config
    type(field_type),         intent(inout) :: increment
    type(field_type),         intent(in)    :: field_in, field_ref
    real(kind=r_def),         intent(in)    :: time_weight
    type(integer_field_type), intent(in)    :: tropopause_level

    type(mesh_type),           pointer :: mesh, coarse_mesh
    type(field_type),          pointer :: convolution_weights
    real(kind=r_def),          pointer :: vertical_weights(:)
    type(function_space_type), pointer :: fs

    type(field_type)    :: coarse_field_in, coarse_increment, coarse_field_diff
    integer(kind=i_def) :: fs_id, coarse_mesh_id
    integer(kind=i_def) :: nvert(1)
    integer(kind=tik)   :: id

    ! Config variables
    logical(kind=l_def)    :: coarse_nudging, use_multires_coupling
    integer(kind=i_def)    :: nudging_method, spectral_stencil_extent
    integer(kind=i_def)    :: theta_forcing, wind_forcing
    integer(kind=i_def)    :: min_level, max_level
    character(len=str_def) :: nudging_mesh_name
    real(kind=r_def)       :: p_zero, kappa

    if ( LPROF ) call start_timing( id, 'nudging' )

    ! ------------------------------------------------------------------------ !
    ! Get config variables
    ! ------------------------------------------------------------------------ !

    use_multires_coupling = config%formulation%use_multires_coupling()
    nudging_method = config%nudging%nudging_method()
    spectral_stencil_extent = config%nudging%spectral_stencil_extent()
    theta_forcing = config%external_forcing%theta_forcing()
    wind_forcing = config%external_forcing%wind_forcing()
    nudging_mesh_name = config%multires_coupling%nudging_mesh_name()
    p_zero = config%planet%p_zero()
    kappa = config%planet%kappa()
    min_level = config%nudging%nudging_level_taper_bottom()
    max_level = config%nudging%nudging_level_taper_top()

    ! Getting nudging mesh name
    coarse_nudging = .false.
    nudging_mesh_name = config%base_mesh%prime_mesh_name()
    if (use_multires_coupling) then
      coarse_nudging = config%multires_coupling%coarse_nudging()
      if (coarse_nudging) then
        nudging_mesh_name = config%multires_coupling%nudging_mesh_name()
      end if
    end if

    ! ------------------------------------------------------------------------ !
    ! Set pointers and initialise fields
    ! ------------------------------------------------------------------------ !

    if (use_multires_coupling .and. coarse_nudging) then
      coarse_mesh => mesh_collection%get_mesh(trim(nudging_mesh_name))
    else
      mesh => field_in%get_mesh()
      coarse_mesh => mesh
    end if

    ! Check reference field is on the correct mesh
    coarse_mesh_id = coarse_mesh%get_id()
    if (coarse_mesh_id /= field_ref%get_mesh_id()) then

      call log_event(                                                          &
              "nudging_alg: reference field is not on the mesh " //            &
              "specified for nudging",                                         &
              LOG_LEVEL_ERROR                                                  &
      )
    end if

    ! Initialise coarse fields
    fs => field_ref%get_function_space()
    call coarse_field_in%initialise(fs)
    call coarse_increment%initialise(fs)

    ! Point to weights used for nudging
    fs_id = field_ref%which_function_space()
    vertical_weights => get_nudging_weights(config, coarse_mesh, fs_id)
    nvert(:) = SIZE(vertical_weights)

    ! ------------------------------------------------------------------------ !
    ! Coarsen
    ! ------------------------------------------------------------------------ !

    if (coarse_nudging) then
      call map_scalar_intermesh(coarse_field_in, field_in)
    else
      call invoke( setval_X(coarse_field_in, field_in) )
    end if

    select case (nudging_method)

    ! ------------------------------------------------------------------------ !
    ! Newtonian relaxation
    ! ------------------------------------------------------------------------ !
    case (nudging_method_newtonian)
      ! Simply nudge towards reference field, with no spectral impact
      call invoke(                                                             &
          setval_c(coarse_increment, 0.0_r_def)                                &
      )
      call invoke_newtonian_nudging_kernel_type(                               &
              coarse_increment, coarse_field_in, field_ref,                    &
              vertical_weights, tropopause_level,                              &
              min_level, max_level, time_weight, nvert                         &
      )

    ! ------------------------------------------------------------------------ !
    ! Convolution
    ! ------------------------------------------------------------------------ !
    case (nudging_method_convolution)
      ! Filter difference using a convolution in physical space
      convolution_weights => get_convolution_weights(config, coarse_mesh)
      call coarse_field_diff%initialise(fs, halo_depth=spectral_stencil_extent)
      call invoke(                                                             &
          X_minus_Y(coarse_field_diff, field_ref, coarse_field_in),            &
          ! Compute convolution
          setval_c(coarse_increment, 0.0_r_def)                                &
      )
      call invoke_convolution_2d_kernel_type(                                  &
              coarse_increment, coarse_field_diff, spectral_stencil_extent,    &
              vertical_weights, convolution_weights,                           &
              tropopause_level, min_level, max_level, time_weight, nvert       &
      )

    end select

    ! ------------------------------------------------------------------------ !
    ! Reconstruction
    ! ------------------------------------------------------------------------ !

    if (coarse_nudging) then
      call prolong_scalar_simple(                                              &
          increment, coarse_increment, recovery_order_linear                   &
      )
    else
      call invoke( setval_X(increment, coarse_increment) )
    end if

    if ( LPROF ) call stop_timing( id, 'nudging' )

  end subroutine nudging_alg

  !> @brief Computes a spinup factor for nudging based on the current time
  !> @param[in] config    Application namelist configuration object
  !> @param[in] time      Current model time in seconds
  !> @return              Spinup factor for nudging, between 0 and 1
  function compute_nudging_spinup_factor(config, time) result(spinup_factor)

    implicit none

    type(config_type), intent(in) :: config
    real(kind=r_def),  intent(in) :: time

    ! Local variables
    real(kind=r_def) :: nudging_spinup_start
    real(kind=r_def) :: nudging_spinup_end
    real(kind=r_def) :: nudging_stop_time
    real(kind=r_def) :: time_hours
    real(kind=r_def) :: spinup_factor

    nudging_spinup_start = config%nudging%nudging_spinup_start()
    nudging_spinup_end = config%nudging%nudging_spinup_end()
    nudging_stop_time = config%nudging%nudging_stop_time()

    ! Convert time to hours
    time_hours = time / 3600.0_r_def

    if (time_hours < nudging_spinup_start) then
      spinup_factor = 0.0_r_def
    else if (time_hours < nudging_spinup_end) then
      spinup_factor = (                                                        &
        (time_hours - nudging_spinup_start)                                    &
        / (nudging_spinup_end - nudging_spinup_start)                          &
      )
    else if (time_hours < nudging_stop_time) then
      spinup_factor = 1.0_r_def
    else
      spinup_factor = 0.0_r_def
    end if

  end function compute_nudging_spinup_factor

  !> @brief Sets the tropopause level for nudging based on  current model state
  !> @param[in]     config        Application namelist configuration object
  !> @param[in,out] trop_level    Level of tropopause
  !> @param[in]     theta         Potential temperature
  !> @param[in]     exner         Exner pressure field (in same space as theta)
  subroutine set_nudging_trop_level(config, trop_level, theta, exner)

#ifdef UM_PHYSICS
    use locate_tropopause_alg_mod, only: locate_tropopause_alg
#endif

    implicit none

    type(config_type),        intent(in)    :: config
    type(integer_field_type), intent(inout) :: trop_level
    type(field_type), target, intent(in)    :: theta, exner

    ! Local variables
    integer(kind=i_def) :: nudging_min_tropopause_level
    integer(kind=i_def) :: nudging_level_taper_top
    character(str_def)  :: nudging_mesh_name
    logical(kind=l_def) :: coarse_nudging

    type(mesh_type),           pointer :: nudging_mesh
    type(mesh_type),           pointer :: nudging_twod_mesh
    type(function_space_type), pointer :: w3_2d_fs, wt_fs
#ifdef UM_PHYSICS
    type(field_type),          pointer :: exner_trop, theta_trop
    type(field_type),          target  :: exner_coarse, theta_coarse
#endif

    nudging_min_tropopause_level = config%nudging%nudging_min_tropopause_level()
    nudging_level_taper_top = config%nudging%nudging_level_taper_top()
    coarse_nudging = config%multires_coupling%coarse_nudging()

    nudging_mesh_name = trim(config%multires_coupling%nudging_mesh_name())
    nudging_mesh => mesh_collection%get_mesh(nudging_mesh_name)
    nudging_twod_mesh => mesh_collection%get_mesh(nudging_mesh, TWOD)
    w3_2d_fs => function_space_collection%get_fs(nudging_twod_mesh, 0, 0, W3)
    wt_fs => function_space_collection%get_fs(nudging_mesh, 0, 0, Wtheta)

    call trop_level%initialise(w3_2d_fs)

    if (nudging_min_tropopause_level < nudging_level_taper_top) then
#ifdef UM_PHYSICS
      if (coarse_nudging) then
        ! TODO: already have coarse exner from setting reference fields, and
        ! will need coarse theta for nudging. So could save a small bit of work
        ! by pulling these mappings out to somewhere else (but it would be messy)
        call exner_coarse%initialise(wt_fs)
        call theta_coarse%initialise(wt_fs)
        call map_scalar_intermesh(exner_coarse, exner)
        call map_scalar_intermesh(theta_coarse, theta)
        exner_trop => exner_coarse
        theta_trop => theta_coarse
      else
        exner_trop => exner
        theta_trop => theta
      end if

      call locate_tropopause_alg(                                              &
              config, trop_level, theta_trop, exner_trop,                      &
              nudging_twod_mesh, trop_diag=.false.                             &
      )
      call invoke( int_inc_max_aX(nudging_min_tropopause_level, trop_level) )
#else
      call invoke( int_setval_c(trop_level, nudging_min_tropopause_level) )
#endif
    else
      call invoke( int_setval_c(trop_level, nudging_min_tropopause_level) )
    end if

  end subroutine set_nudging_trop_level

  !> @brief Sets the reference fields for nudging from external data
  !> @param[in]     config             Application namelist configuration object
  !> @param[in,out] derived_fields     Collection of derived fields, which holds
  !!                                   both the model's reference fields and any
  !!                                   external reference fields
  !> @param[in]     exner              Current Exner pressure field
  subroutine set_nudging_reference_fields(config, derived_fields, exner)

    use nudging_config_mod, only: nudging_source_ecmwf

    implicit none

    ! Arguments
    type(config_type),           intent(in)    :: config
    type(field_collection_type), intent(inout) :: derived_fields
    type(field_type),    target, intent(in)    :: exner

    ! Local variables
    type(field_type), pointer :: theta_ref
    type(field_type), pointer :: u_in_w3_ref
    type(field_type), pointer :: v_in_w3_ref
    type(field_type), pointer :: T_nudging_ext_ref
    type(field_type), pointer :: u_nudging_ext_ref
    type(field_type), pointer :: v_nudging_ext_ref
    type(field_type), pointer :: surfp_nudging_ext_ref
    type(field_type), pointer :: exner_in_wth
    type(field_type), pointer :: exner_in_w3
    type(field_type), target  :: exner_in_wth_coarse
    type(field_type), target  :: exner_in_w3_coarse

    ! Config variables
    integer(kind=i_def)    :: theta_forcing, wind_forcing
    integer(kind=i_def)    :: num_ref_data_levels
    real(kind=r_def)       :: p_zero, kappa
    logical(kind=l_def)    :: coarse_nudging
    integer(kind=i_def)    :: nudging_source

    ! Get config variables
    theta_forcing = config%external_forcing%theta_forcing()
    wind_forcing = config%external_forcing%wind_forcing()
    num_ref_data_levels = config%nudging%num_ref_data_levels()
    p_zero = config%planet%p_zero()
    kappa = config%planet%kappa()
    coarse_nudging = config%multires_coupling%coarse_nudging()
    nudging_source = config%nudging%nudging_source()

    ! Get target reference fields from derived field collection
    if (theta_forcing == theta_forcing_nudging) then
      call derived_fields%get_field('theta_nudging_ref', theta_ref)
    end if

    if (wind_forcing == wind_forcing_nudging) then
      call derived_fields%get_field('u_in_w3_nudging_ref', u_in_w3_ref)
      call derived_fields%get_field('v_in_w3_nudging_ref', v_in_w3_ref)
    end if

    ! ------------------------------------------------------------------------ !
    ! Set reference fields based on input external data
    ! ------------------------------------------------------------------------ !
    if (.not. (theta_forcing == theta_forcing_nudging .or.                     &
                wind_forcing == wind_forcing_nudging) ) then
      call log_event(                                                          &
          "set_nudging_reference_fields: nudging to external data. This " //   &
          "is currently only implemented to nudge both theta and wind",        &
          LOG_LEVEL_ERROR                                                      &
      )
    end if

    if (nudging_source == nudging_source_ecmwf) then
      ! Get external fields
      call derived_fields%get_field('temperature_nudging_ext_ref', T_nudging_ext_ref)
      call derived_fields%get_field('u_nudging_ext_ref', u_nudging_ext_ref)
      call derived_fields%get_field('v_nudging_ext_ref', v_nudging_ext_ref)
      call derived_fields%get_field('exner_in_wth', exner_in_wth)
      call derived_fields%get_field(                                           &
          'surface_pressure_nudging_ext_ref', surfp_nudging_ext_ref            &
      )

      ! Map Exner fields to coarse mesh, if required
      if (coarse_nudging) then
        call exner_in_wth_coarse%initialise(theta_ref%get_function_space())
        call exner_in_w3_coarse%initialise(u_in_w3_ref%get_function_space())
        call map_scalar_intermesh(exner_in_wth_coarse, exner_in_wth)
        call map_scalar_intermesh(exner_in_w3_coarse, exner)
        exner_in_wth => exner_in_wth_coarse
        exner_in_w3 => exner_in_w3_coarse
      else
        exner_in_w3 => exner
      end if

      ! Vertical remapping of external fields to model levels
      call invoke(                                                             &
          nudging_ecmwf_vert_interp_kernel_type(                               &
              theta_ref, u_in_w3_ref, v_in_w3_ref,                             &
              T_nudging_ext_ref, u_nudging_ext_ref, v_nudging_ext_ref,         &
              exner_in_wth, exner_in_w3, surfp_nudging_ext_ref,                &
              p_zero, kappa, num_ref_data_levels                               &
          )                                                                    &
      )
    else
      call log_event(                                                          &
          "set_nudging_reference_fields: nudging_source is only currently " // &
          "implemented for nudging_source_ecmwf",  LOG_LEVEL_ERROR             &
      )
    end if

  end subroutine set_nudging_reference_fields


end module nudging_alg_mod
