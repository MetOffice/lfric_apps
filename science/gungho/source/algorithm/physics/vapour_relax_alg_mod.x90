!-------------------------------------------------------------------------------
!> @brief Newtonian relaxation of water vapour
!> @details This is intended for use in cloud resolving model simulations in a
!>          Cartesian domain. Newtonian relaxation is applied to the horizontal
!>          mean of either vapour mixing ratio or relative humidity.
!>          Using \f$f_\mathrm{vap}(t,\mathbf{x},z)\f$, to represent
!>          either of these fields, the relaxation forcing increment is
!>          obtained by applyying the forward Euler discretisation to
!>          \f[
!>             \frac{\partial f_\mathrm{vap}}{\partial t} =
!>             -\frac{\overline{f_\mathrm{vap}}(t,z)-f_{\mathrm vap_target}(t,z)}
!>                   {\tau},
!>          \f]
!>          where \f$f_{\mathrm vap_target}(t,z)\f$ is the target profile,
!>          which may be time-varying, and \f$\tau\f$ is the timescale for
!>          the relaxation.
module vapour_relax_alg_mod

  use config_mod,                    only: config_type
  use constants_mod,                 only: i_def, r_def, l_def
  use field_mod,                     only: field_type
  use fs_continuity_mod,             only: Wtheta, W3
  use function_space_collection_mod, only: function_space_collection
  use sci_geometric_constants_mod,   only: get_height_fv
  use mesh_mod,                      only: mesh_type
  use planet_config_mod,             only: kappa, p_zero, recip_epsilon, &
                                           epsilon
  use timestepping_config_mod,       only: dt
  !> @todo Data passed to the kernel via module 'use' statements.
  !>       When PSyclone supports passing of arrays into kernels (issue #1312),
  !>       these data should be passed through the argument list of the invoke.
  use profile_interp_kernel_mod,     only: profile_interp_kernel_type, &
                                           profile_size,               &
                                           profile_data,               &
                                           profile_heights
  use prof_temporal_interp_mod,      only: prof_temporal_interp
  use relative_humidity_kernel_mod,  only: relative_humidity_kernel_type
  use rh_to_mr_kernel_mod,           only: rh_to_mr_kernel_type


  implicit none

  private
  public :: vapour_relax_alg

contains

  !> @brief Algorithm to calculate Newtonian relaxation of potential temperature
  !> @param[in]     config          Application namelist configuration object
  !> @param[in,out] dmv_forcing Relaxation increment
  !> @param[in]     mr_v  Vapour mixing ratio
  !> @param[in]     theta Dry potential temperature
  !> @param[in]     exner_in_wth Exner mapped to Wtheta space
  !> @param[in]     twod_mesh Information  about the horizontal mesh
  !> @param[in]     time_now Current model time in seconds
  !> @param[in]     nlayers Number of layers in the grid
  subroutine vapour_relax_alg( config, dmv_forcing, mr_v, theta, exner_in_wth, &
                               twod_mesh, time_now, nlayers )

  use vapour_relax_config_mod, only: number_times,                      &
                                     number_heights,                    &
                                     times,                             &
                                     heights,                           &
                                     coordinate,                        &
                                     coordinate_pressure,               &
                                     vapour_relax_data => profile_data, &
                                     timescale,                         &
                                     variable,                          &
                                     variable_mr,                       &
                                     variable_rh

  use horiz_mean_alg_mod, only: horiz_mean_alg

  implicit none

  type(config_type), intent(in) :: config

  type( field_type ), intent(inout)       :: dmv_forcing
  type( field_type ), intent(in), target  :: mr_v, theta
  type( field_type ), intent(in), target  :: exner_in_wth
  type( mesh_type ),  intent(in), pointer :: twod_mesh

  real( kind=r_def ),    intent(in) :: time_now
  integer( kind=i_def ), intent(in) :: nlayers

  real( kind=r_def )          :: dt_rdef
!  real( kind=r_def )          :: vapour_field(number_heights)
  real( kind=r_def )          :: vapour_target(number_heights)
  real( kind=r_def )          :: relaxation_coeff
  integer( kind=i_def )       :: k
  logical( kind=l_def )       :: profile_extrap
  type( field_type )          :: dmv_relax
  type( field_type ), target  :: rel_humidity
  type( field_type ), target  :: horiz_mean
  type( field_type ), pointer :: height_wth
  type( field_type ), pointer :: vapour_field
  type( mesh_type ),  pointer :: mesh

  nullify (mesh, vapour_field, height_wth )

  select case( variable )
  case( variable_rh )
    call rel_humidity%initialise( vector_space = dmv_forcing%get_function_space() )
    call invoke( relative_humidity_kernel_type( rel_humidity, mr_v,   &
                                                theta, exner_in_wth,  &
                                                recip_epsilon, kappa, &
                                                p_zero ) )
    vapour_field => rel_humidity
  case( variable_mr )
    vapour_field => mr_v
  end select

  ! Only apply relaxation between the specified times, unless only
  ! one time is specified. In the later case relaxation applies at all times.
  if ( number_times > 1 .and. &
       ( time_now < times(1) .or. time_now > times(number_times) ) ) return

  dt_rdef = real( dt, kind=r_def )

  relaxation_coeff = dt_rdef / timescale

  call horiz_mean%initialise( vector_space = dmv_forcing%get_function_space() )

  call dmv_relax%initialise( vector_space = dmv_forcing%get_function_space() )

  if ( number_times == 1 ) then
    vapour_target(:) = vapour_relax_data(:)
  else
    call prof_temporal_interp( time_now, number_heights, number_times, times, &
                               vapour_relax_data, vapour_target )
  end if

  call horiz_mean_alg( horiz_mean, nlayers, twod_mesh, vapour_field )

  if ( number_heights == 1 ) then
    call invoke( setval_c( dmv_relax, vapour_target(1) ),     &
                 inc_X_minus_Y( dmv_relax, horiz_mean ) )
  else
    profile_size = number_heights
    profile_data( 1:profile_size ) = vapour_target( 1:profile_size )
    profile_heights( 1:profile_size ) = heights( 1:profile_size )
    if ( coordinate == coordinate_pressure ) then
      ! If the target profile is specified with pressure as the vertical
      ! coordinate then use Exner as the interpolation coordinate. This
      ! avoids having to create the p_in_wth field for use as vertical
      ! coordinate of the model data.
      do k = 1, number_heights
        profile_heights(k) = (profile_heights(k) / p_zero) ** kappa
      end do
      height_wth => exner_in_wth
    else
      mesh => dmv_relax%get_mesh()
      height_wth => get_height_fv( config, mesh, Wtheta )
    end if
    profile_extrap = .false.
    call invoke( setval_X( dmv_relax, horiz_mean),                  &
                 profile_interp_kernel_type( dmv_relax, height_wth, &
                                             profile_extrap ),      &
                 inc_X_minus_Y( dmv_relax, horiz_mean ) )

  end if

  select case( variable )
  case( variable_rh )
    ! dmv_relax contains a relative humidity increment.
    ! To obtain mixing ratio increment:
    ! 1. calculate rel_humidity + increment;
    ! 2. convert to mixing ratio; and
    ! 3. calculate mixing ratio increment.
    call invoke( inc_X_plus_Y( rel_humidity, dmv_relax ),                  &
                 rh_to_mr_kernel_type( rel_humidity, dmv_relax, theta,     &
                                       exner_in_wth, recip_epsilon, kappa, &
                                       p_zero ),                           &
                 inc_X_minus_Y( dmv_relax, mr_v ) )
  end select

  call invoke( inc_a_times_X( relaxation_coeff, dmv_relax ), &
               inc_X_plus_Y( dmv_forcing, dmv_relax ) )

  end subroutine vapour_relax_alg
end module vapour_relax_alg_mod
