!-------------------------------------------------------------------------------
!> @brief Newtonian relaxation of horizontal wind
!> @details This is intended for use in cloud resolving model simulations in a
!>          Cartesian domain. Newtonian relaxation is applied to the horizontal
!>          mean wind components,\f$\mathbf{u}(t,\mathbf{x},z)\f$,
!>          \f[
!>             \frac{\partial\mathbf{u}}{\partial t} =
!>             -\frac{\overline{\mathbf{u}}(t,z)-\mathbf{u}_{\mathrm target}(t,z)}
!>                   {\tau},
!>          \f]
!>          where \f$\mathbf{u}_{\mathrm target}(t,z)\f$ is the target profile,
!>          which may be time-varying, and \f$\tau\f$ is the timescale for
!>          the relaxation.
module wind_relax_alg_mod

  use constants_mod,                 only: i_def, r_def, l_def
  use field_mod,                     only: field_type
  use fs_continuity_mod,             only: Wtheta, W3
  use function_space_collection_mod, only: function_space_collection
  use sci_geometric_constants_mod,   only: get_height_fv
  use log_mod,                       only: log_event, LOG_LEVEL_ERROR
  use mesh_mod,                      only: mesh_type
  use physics_mappings_alg_mod,      only: map_physics_winds
  use map_fd_to_prognostics_alg_mod, only: set_wind
  use planet_config_mod,             only: kappa, p_zero
  use timestepping_config_mod,       only: dt
  use profile_interp_kernel_mod,     only: profile_interp_kernel_type, &
                                           profile_size,               &
                                           profile_data,               &
                                           profile_heights
  use prof_temporal_interp_mod,      only: prof_temporal_interp

  implicit none

  private
  public :: wind_relax_alg

contains

  !> @brief Algorithm to calculate Newtonian relaxation of horizontal wind
  !> @param[in,out] du_forcing Relaxation increment
  !> @param[in]     u Horizontal wind field
  !> @param[in]     exner pressure in original W3 space
  !> @param[in]     twod_mesh Information  about the horizontal mesh
  !> @param[in]     time_now Current model time in seconds
  !> @param[in]     nlayers Number of layers in the grid
  subroutine wind_relax_alg( du_forcing, u, exner,    &
                              twod_mesh, time_now, nlayers )

  use wind_relax_config_mod, only:  number_times,                        &
                                    number_heights,                      &
                                    times,                               &
                                    heights,                             &
                                    coordinate,                          &
                                    coordinate_pressure,                 &
                                    u_wind_relax_data => u_profile_data, &
                                    v_wind_relax_data => v_profile_data, &
                                    timescale

  use horiz_mean_alg_mod, only: horiz_mean_alg

  implicit none

  type( field_type ), intent(inout)       :: du_forcing
  type( field_type ), intent(in), target  :: u
  type( mesh_type ),  intent(in), pointer :: twod_mesh
  type( field_type ), intent(in), target  :: exner

  real( kind=r_def ),    intent(in) :: time_now
  integer( kind=i_def ), intent(in) :: nlayers

  real( kind=r_def )          :: dt_rdef
  real( kind=r_def )          :: u_wind_relax_now(number_heights)
  real( kind=r_def )          :: v_wind_relax_now(number_heights)
  real( kind=r_def )          :: relaxation_coeff
  integer( kind=i_def )       :: k, mesh_id
  logical( kind=l_def )       :: profile_extrap

  ! Horizontal winds may need to be assigned as relaxation targets
  type( field_type ), target  :: u_in_w3 
  type( field_type ), target  :: v_in_w3 
  type( field_type )          :: w_in_w3 

  ! w2 field for relaxation increments
  type( field_type )          :: du_relaxation_forcing
  ! Physics fields for relaxation components
  type( field_type )          :: du_relax
  type( field_type )          :: dv_relax
  type( field_type )          :: dw_relax

  type( field_type ), target  :: u_horiz_mean
  type( field_type ), target  :: v_horiz_mean

  type( field_type ), pointer :: height_w3 => null()
  type( field_type ), pointer :: u_relax_target => null()
  type( field_type ), pointer :: v_relax_target => null()
  type( mesh_type ),  pointer :: mesh

  ! Only apply relaxation between the specified times, unless only
  ! one time is specified. In the later case relaxation applies at all times.
  if ( number_times > 1 .and. &
       ( time_now < times(1) .or. time_now > times(number_times) ) ) return

  dt_rdef = real( dt, kind=r_def )

  relaxation_coeff = dt_rdef / timescale
  
  mesh => du_forcing%get_mesh()

  call du_relaxation_forcing%initialise( vector_space = u%get_function_space() )

  call u_in_w3%initialise( vector_space = &
                function_space_collection%get_fs( mesh, 0, 0, W3 ) )

  call v_in_w3%initialise( vector_space = &
                function_space_collection%get_fs( mesh, 0, 0, W3 ) )

  call w_in_w3%initialise( vector_space = &
                function_space_collection%get_fs( mesh, 0, 0, W3 ) )

  call du_relax%initialise( vector_space = u_in_w3%get_function_space() )

  call dv_relax%initialise( vector_space = v_in_w3%get_function_space() )

  call dw_relax%initialise( vector_space = &
                function_space_collection%get_fs( mesh, 0, 0, Wtheta ) )

  ! Set dw_relax to zero
  call invoke( setval_c( dw_relax, 0.0_r_def ) )

  ! Map the actual w2 wind field to physics components
  call map_physics_winds( u_in_w3, v_in_w3, w_in_w3, u )

  if ( number_times == 1 ) then
  ! This is what applies for a constant relaxation profile
    u_wind_relax_now(:) = u_wind_relax_data(:)
    v_wind_relax_now(:) = v_wind_relax_data(:)
  else
  ! Interpolate the relaxation time series to current time
    call prof_temporal_interp( time_now, number_heights, number_times, times, &
                               u_wind_relax_data, u_wind_relax_now )
    call prof_temporal_interp( time_now, number_heights, number_times, times, &
                               v_wind_relax_data, v_wind_relax_now )
  end if

  ! Initialize the temporary fields to hold the horizontal means
  call u_horiz_mean%initialise( vector_space = u_in_w3%get_function_space() )
  call v_horiz_mean%initialise( vector_space = v_in_w3%get_function_space() )
  ! Calculate the horizontal mean of the wind components
  call horiz_mean_alg( u_horiz_mean, nlayers, twod_mesh, u_in_w3 )
  call horiz_mean_alg( v_horiz_mean, nlayers, twod_mesh, v_in_w3 )
  u_relax_target => u_horiz_mean
  v_relax_target => v_horiz_mean

  ! Removed ability to do local relaxation; split off to a different module.
  ! if ( relax_by_domain_mean ) then
    ! Initialize the temporary fields to hold the horizontal means
    ! call u_horiz_mean%initialise( vector_space = u_in_w3%get_function_space() )
    ! all v_horiz_mean%initialise( vector_space = v_in_w3%get_function_space() )
    ! Calculate the horizontal mean of the wind components
    ! call horiz_mean_alg( u_horiz_mean, nlayers, twod_mesh, u_in_w3 )
    ! call horiz_mean_alg( v_horiz_mean, nlayers, twod_mesh, v_in_w3 )
    ! Set the targeted relaxation field to be the horizontal mean
    ! u_relax_target => u_horiz_mean
    ! v_relax_target => v_horiz_mean
  ! else 
    ! Set the targeted relaxation field to be the physical winds
    ! This imposes strict local relaxation
  !  u_relax_target => u_in_w3
  !  v_relax_target => v_in_w3
  !end if

  if ( number_heights == 1 ) then
    ! Constant relaxation with height
    ! Calculate the relaxation increments
    call invoke( setval_c( du_relax, u_wind_relax_now(1) ),     &
                 inc_X_minus_Y( du_relax, u_relax_target ),       &
                 inc_a_times_X( relaxation_coeff, du_relax ) )
    call invoke( setval_c( dv_relax, v_wind_relax_now(1) ),     &
                 inc_X_minus_Y( dv_relax, v_relax_target ),       &
                 inc_a_times_X( relaxation_coeff, dv_relax ) )
    ! Transform the relaxation increments back to w2 space
    call set_wind( du_relaxation_forcing, du_relax, dv_relax, dw_relax)
    ! Add relaxation increments to forcing
    call invoke( inc_X_plus_Y( du_forcing, du_relaxation_forcing ) )

  else
    ! Specified relaxation profile with height
    profile_size = number_heights
    ! Copy over the u-wind relaxation profile into module global profile_data
    ! needed for the interpolation kernel
    profile_data( 1:profile_size ) = u_wind_relax_now( 1:profile_size )
    ! Copy over the reference heights
    profile_heights( 1:profile_size ) = heights( 1:profile_size )

    if ( coordinate == coordinate_pressure ) then
      ! If the target profile is specified with pressure as the vertical
      ! coordinate then use Exner as the interpolation coordinate. This
      ! avoids having to create the pressure field for use as vertical
      ! coordinate of the model data.
      do k = 1, number_heights
        profile_heights(k) = (profile_heights(k) / p_zero) ** kappa
      end do
      height_w3 => exner
    else
      mesh_id = du_relax%get_mesh_id()
      height_w3 => get_height_fv( W3, mesh_id )
    end if
    profile_extrap = .false.
    call invoke( setval_X( du_relax, u_relax_target),                  &
                 ! Write interpolated profile to du_relax
                 profile_interp_kernel_type( du_relax, height_w3, &
                                             profile_extrap ),         &
                 ! Find the difference; this is zero for levels outside of profile range
                 inc_X_minus_Y( du_relax, u_relax_target ),            &
                 inc_a_times_X( relaxation_coeff, du_relax ) )
    ! Now repeat for v-wind
    profile_data( 1:profile_size ) = v_wind_relax_now( 1:profile_size )
    ! Reuse the same profile_heights
    ! Not sure if profile_extrap is changed; just to be safe
    profile_extrap = .false.
    call invoke( setval_X( dv_relax, v_relax_target),                  &
                 profile_interp_kernel_type( dv_relax, height_w3, &
                                             profile_extrap ),         &
                 inc_X_minus_Y( dv_relax, v_relax_target ),            &
                 inc_a_times_X( relaxation_coeff, dv_relax ) )
    ! Transform the relaxation increments back to w2 space
    call set_wind( du_relaxation_forcing, du_relax, dv_relax, dw_relax)
    ! Add relaxation increments to forcing
    call invoke( inc_X_plus_Y( du_forcing, du_relaxation_forcing ) ) 

  end if

  end subroutine wind_relax_alg
end module wind_relax_alg_mod