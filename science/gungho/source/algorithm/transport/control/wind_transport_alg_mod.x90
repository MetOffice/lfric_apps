!> @brief Contains routine for transporting the wind field.

module wind_transport_alg_mod

  use constants_mod,                  only: i_def, r_def, l_def
  use sci_dg_convert_hdiv_field_kernel_mod,                                    &
                                      only: dg_convert_hdiv_field_kernel_type
  use sci_dg_convert_hdiv_native_kernel_mod,                                   &
                                      only: dg_convert_hdiv_native_kernel_type
  use sci_enforce_bc_kernel_mod,      only: enforce_bc_kernel_type
  use sci_fem_constants_mod,          only: get_mass_matrix_fe,         &
                                            get_mass_matrix_fv,         &
                                            get_rmultiplicity_fe,       &
                                            get_rmultiplicity_fv,       &
                                            get_inverse_mass_matrix_fe, &
                                            get_inverse_mass_matrix_fv
  use field_mod,                      only: field_type
  use finite_element_config_mod,      only: coord_system, coord_system_native
  use formulation_config_mod,         only: si_momentum_equation
  use fs_continuity_mod,              only: W2, W3, W2broken, Wtheta, W2h
  use function_space_mod,             only: function_space_type
  use function_space_collection_mod,  only: function_space_collection
  use sci_geometric_constants_mod,    only: get_coordinates,      &
                                            get_panel_id,         &
                                            get_da_at_w2,         &
                                            get_height_fv,        &
                                            get_face_selector_ew, &
                                            get_face_selector_ns
  use log_mod,                        only: log_event,       &
                                            LOG_LEVEL_ERROR, &
                                            LOG_LEVEL_DEBUG, &
                                            LOG_LEVEL_TRACE
  use sci_mapping_constants_mod,      only: get_project_xdot_to_w2,  &
                                            get_project_ydot_to_w2,  &
                                            get_project_zdot_to_w2
  use mesh_mod,                       only: mesh_type
  use operator_mod,                   only: operator_type
  use timing_mod,                     only: start_timing, stop_timing, &
                                            tik, LPROF
  use transport_config_mod,           only: broken_w2_projection, &
                                            native_w2_wind_transport
  use transport_constants_mod,        only: get_element_order_h_transport, &
                                            get_element_order_v_transport
  use transport_controller_mod,       only: transport_controller_type
  use transport_enumerated_types_mod, only: equation_form_advective
  use transport_field_mod,            only: transport_field
  use transport_metadata_mod,         only: transport_metadata_type
  use split_w2_to_ws_kernel_mod,      only: split_w2_to_ws_kernel_type
  use combine_ws_to_w2_kernel_mod,    only: combine_ws_to_w2_kernel_type
  use apply_w2_area_and_slope_kernel_mod,                                      &
                                      only: apply_w2_area_and_slope_kernel_type
  use wind_metric_increment_w3_kernel_mod,                                     &
                                      only: wind_metric_increment_w3_kernel_type
  use wind_metric_increment_to_w2h_kernel_mod,                                 &
      only: wind_metric_increment_to_w2h_kernel_type
  use wind_metric_increment_to_wtheta_kernel_mod,                              &
      only: wind_metric_increment_to_wtheta_kernel_type
  use base_mesh_config_mod,           only: geometry,           &
                                            geometry_spherical, &
                                            topology,           &
                                            topology_fully_periodic
  use config_mod,                     only: config_type
  use integer_field_mod,              only: integer_field_type
  use planet_config_mod,              only: scaled_radius
  use r_tran_field_mod,               only: r_tran_field_type
  use sci_chi_transform_mod,          only: get_to_stretch

  implicit none

  private

  public :: wind_transport_alg

contains

  !=============================================================================
  !> @brief Central routine for transporting the wind field.
  !> @details Performs a whole transport time step for the wind field, with
  !!          different routines called depending on the form of the transport
  !!          equation being used.
  !> @param[in,out] rhs_u              Right-hand-side for weak wind transport
  !!                                   equation. In other words, the advective
  !!                                   increment to the wind multiplied by the
  !!                                   W2 mass matrix.
  !> @param[in]     wind_n             Wind field at start of transport step
  !> @param[in,out] transport_controller
  !!                                   Encapsulating object containing the
  !!                                   transport counter and precomputations
  !> @param[in,out] transport_metadata Contains the configuration options for
  !!                                   transporting these fields
  subroutine wind_transport_alg(rhs_u, wind_n, transport_controller,           &
                                transport_metadata)

    use dg_matrix_vector_kernel_mod,      only: dg_matrix_vector_kernel_type
    use dg_inc_matrix_vector_kernel_mod,  only: dg_inc_matrix_vector_kernel_type
    use matrix_vector_kernel_mod,         only: matrix_vector_kernel_type
    use sci_average_w2b_to_w2_kernel_mod, only: average_w2b_to_w2_kernel_type
    use sci_field_minmax_alg_mod,         only: log_field_minmax

    implicit none

    ! Arguments
    type(field_type),                intent(inout) :: rhs_u
    type(field_type),                intent(in)    :: wind_n
    type(transport_controller_type), intent(inout) :: transport_controller
    type(transport_metadata_type),   intent(inout) :: transport_metadata

    ! Internal variables
    type(mesh_type),           pointer  :: mesh
    integer(kind=i_def)                 :: dir
    integer(kind=i_def)                 :: k_h, k_v
    type(field_type)                    :: u_w3_n(3), u_w3_inc(3), u_w3_np1(3)
    type(field_type)                    :: uv_w2h_n, uv_w2h_inc, uv_w2h_np1
    type(field_type)                    :: w_wt_n, w_wt_inc, w_wt_np1
    type(field_type)                    :: u_w2_inc, u_w2b_inc, rhs_u_broken
    type(field_type),           pointer :: chi(:)
    type(field_type),           pointer :: panel_id
    type(field_type),           pointer :: rmultiplicity_w2
    type(operator_type),        pointer :: mm_w2
    type(operator_type),        pointer :: mm_w2b_inv
    type(operator_type),        pointer :: project_xdot_to_w2
    type(operator_type),        pointer :: project_ydot_to_w2
    type(operator_type),        pointer :: project_zdot_to_w2
    type(function_space_type),  pointer :: w3_fs
    type(function_space_type),  pointer :: wt_fs
    type(function_space_type),  pointer :: w2h_fs
    type(function_space_type),  pointer :: w2_fs
    type(function_space_type),  pointer :: w2b_fs
    logical(kind=l_def)                 :: optimised_conversion
    integer(tik)                        :: id_to, id_from
    type(field_type),           pointer :: da
    type(field_type)                    :: u_w2_inc_scaled
    type(field_type)                    :: uv_w2h_star, uv_w2h_trans
    type(field_type)                    :: w_wt_star, w_wt_trans
    type(field_type),           pointer :: height_w3
    type(field_type),           pointer :: rmultiplicity_w2h
    type(r_tran_field_type),    pointer :: transporting_wind
    type(config_type),          pointer :: config
    type(integer_field_type), pointer   :: face_selector_ew
    type(integer_field_type), pointer   :: face_selector_ns
    logical(kind=l_def)                 :: cubed_sphere
    real(kind=r_def)                    :: dt_metric


    if ( LPROF ) call start_timing( id_to, 'transport.wind' )

    k_h = get_element_order_h_transport()
    k_v = get_element_order_v_transport()

    ! ------------------------------------------------------------------------ !
    ! Semi-implicit formulation
    ! ------------------------------------------------------------------------ !
    if ( si_momentum_equation ) then
      ! Transport terms are handled by the semi-implicit scheme
      ! so the increment is zero
      call invoke( setval_c(rhs_u, 0.0_r_def) )

    else

      mesh => wind_n%get_mesh()
      chi => get_coordinates(mesh)
      panel_id => get_panel_id(mesh)

      ! Transport the wind. First choose form of transport equation
      select case ( transport_metadata%get_equation_form() )

      ! ---------------------------------------------------------------------- !
      ! Advective form of transport equation
      ! ---------------------------------------------------------------------- !
      case ( equation_form_advective )

        if ( native_w2_wind_transport ) then

          ! Transport the winds on their native W2 points
          wt_fs => function_space_collection%get_fs( mesh, k_h, k_v, Wtheta )
          w2h_fs => function_space_collection%get_fs( mesh, k_h, k_v, W2h )
          call uv_w2h_n%initialise( w2h_fs )
          call uv_w2h_inc%initialise( w2h_fs )
          call uv_w2h_np1%initialise( w2h_fs )
          call w_wt_n%initialise( wt_fs )
          call w_wt_inc%initialise( wt_fs )
          call w_wt_np1%initialise( wt_fs )

          face_selector_ew => get_face_selector_ew(mesh)
          face_selector_ns => get_face_selector_ns(mesh)

          dA => get_da_at_w2( mesh )
          call invoke(setval_c(uv_w2h_n, 0.0_r_def),                    &
                      split_w2_to_ws_kernel_type( uv_w2h_n, w_wt_n,     &
                                                  wind_n, chi(3), dA,   &
                                                  face_selector_ew,     &
                                                  face_selector_ns ) )

          w2_fs => function_space_collection%get_fs( mesh, k_h, k_v, W2 )

          if ( geometry == geometry_spherical ) then
            ! Strang splitting of the metric terms: apply them over half a
            ! time step before and after transporting the wind components
            cubed_sphere = ( topology == topology_fully_periodic )
            if ( cubed_sphere .and. get_to_stretch() ) then
              call log_event(                                                  &
                      'Native wind transport metric terms are not valid ' //   &
                      'for stretched cubed-sphere meshes', LOG_LEVEL_ERROR     &
              )
            end if

            config => transport_controller%get_config()
            transporting_wind => transport_controller%get_transporting_wind()
            height_w3 => get_height_fv( config, mesh, W3 )
            rmultiplicity_w2h => get_rmultiplicity_fv( W2h, mesh%get_id() )
            dt_metric = 0.5_r_def                                              &
                        * real( transport_controller%get_dt_substep(), r_def ) &
                        * real( transport_controller%get_num_substeps(), r_def )

            call uv_w2h_star%initialise( w2h_fs )
            call uv_w2h_trans%initialise( w2h_fs )
            call w_wt_star%initialise( wt_fs )
            call w_wt_trans%initialise( wt_fs )

            call apply_wind_metric_terms( uv_w2h_star, w_wt_star,              &
                                          uv_w2h_n, w_wt_n,                    &
                                          transporting_wind, dA,               &
                                          chi(1), chi(2),                      &
                                          height_w3, rmultiplicity_w2h,        &
                                          dt_metric, cubed_sphere, k_h, k_v )

            call transport_field( uv_w2h_trans, uv_w2h_star,                   &
                                  transport_controller, transport_metadata )
            call transport_field( w_wt_trans, w_wt_star,                       &
                                  transport_controller, transport_metadata )

            call apply_wind_metric_terms( uv_w2h_np1, w_wt_np1,                &
                                          uv_w2h_trans, w_wt_trans,            &
                                          transporting_wind, dA,               &
                                          chi(1), chi(2),                      &
                                          height_w3, rmultiplicity_w2h,        &
                                          dt_metric, cubed_sphere, k_h, k_v )

          else

            call transport_field( uv_w2h_np1, uv_w2h_n, transport_controller,  &
                                  transport_metadata )
            call transport_field( w_wt_np1, w_wt_n, transport_controller,      &
                                  transport_metadata )

          end if

          call u_w2_inc%initialise( w2_fs )
          call u_w2_inc_scaled%initialise( w2_fs )
          mm_w2 => get_mass_matrix_fv(W2, mesh%get_id())
          call invoke( name="combine_ws_to_w2_winds",                           &
                       X_minus_Y( uv_w2h_inc, uv_w2h_np1, uv_w2h_n ),           &
                       X_minus_Y( w_wt_inc,   w_wt_np1,   w_wt_n ),             &
                       setval_c(u_w2_inc, 0.0_r_def),                           &
                       combine_ws_to_w2_kernel_type(u_w2_inc, uv_w2h_inc,       &
                                                    w_wt_inc,                   &
                                                    face_selector_ew,           &
                                                    face_selector_ns),          &
                       apply_w2_area_and_slope_kernel_type(                     &
                                       u_w2_inc_scaled,                         &
                                       u_w2_inc, da, chi(3) ),                  &
                       setval_c(rhs_u, 0.0_r_def),                              &
                       matrix_vector_kernel_type(rhs_u, u_w2_inc_scaled,        &
                       mm_w2),                                                  &
                       enforce_bc_kernel_type(rhs_u) )

        else

          ! Compute u in physical space and advect components in geocentric
          ! Cartesian coordinates and then map back to computational form

          mesh => wind_n%get_mesh()
          w3_fs => function_space_collection%get_fs( mesh, k_h, k_v, W3 )

          ! -------------------------------------------------------------------- !
          ! Split wind into components in W3
          ! -------------------------------------------------------------------- !

          do dir = 1,3
            call u_w3_n(dir)%initialise( w3_fs )
            call u_w3_inc(dir)%initialise( w3_fs )
            call u_w3_np1(dir)%initialise( w3_fs )
          end do
          call log_field_minmax( LOG_LEVEL_TRACE, 'advected u', wind_n )

          optimised_conversion = (                                               &
            coord_system == coord_system_native                                  &
            .and. w3_fs%get_element_order_h() == 0                               &
            .and. w3_fs%get_element_order_v() == 0                               &
          )
          if (optimised_conversion) then
            call invoke( dg_convert_hdiv_native_kernel_type(                     &
                    u_w3_n, wind_n, chi, panel_id                                &
            ) )
          else
            call invoke( dg_convert_hdiv_field_kernel_type(                      &
                    u_w3_n, wind_n, chi, panel_id                                &
            ) )
          end if

          call log_field_minmax( LOG_LEVEL_TRACE, 'xdot', u_w3_n(1) )
          call log_field_minmax( LOG_LEVEL_TRACE, 'ydot', u_w3_n(2) )
          call log_field_minmax( LOG_LEVEL_TRACE, 'zdot', u_w3_n(3) )

          ! -------------------------------------------------------------------- !
          ! Transport wind components in W3
          ! -------------------------------------------------------------------- !

          do dir = 1,3
            call transport_field(                                                &
                    u_w3_np1(dir), u_w3_n(dir), transport_controller,            &
                    transport_metadata                                           &
            )
          end do

          ! -------------------------------------------------------------------- !
          ! Return from components to full wind field in W2
          ! -------------------------------------------------------------------- !

          project_xdot_to_w2 => get_project_xdot_to_w2(mesh)
          project_ydot_to_w2 => get_project_ydot_to_w2(mesh)
          project_zdot_to_w2 => get_project_zdot_to_w2(mesh)

          ! Either Galerkin project in W2broken
          if (broken_w2_projection) then
            ! Galerkin projection into W2broken, then restore continuity
            w2_fs => function_space_collection%get_fs( mesh, k_h, k_v, W2 )
            w2b_fs => function_space_collection%get_fs( mesh, k_h, k_v, W2broken )
            if (k_h == 0 .and. k_v == 0) then
              mm_w2 => get_mass_matrix_fv(W2, mesh%get_id())
              mm_w2b_inv => get_inverse_mass_matrix_fv(W2broken, mesh%get_id())
              rmultiplicity_w2 => get_rmultiplicity_fv(W2, mesh%get_id())
            else
              mm_w2 => get_mass_matrix_fe(W2, mesh%get_id())
              mm_w2b_inv => get_inverse_mass_matrix_fe(W2broken, mesh%get_id())
              rmultiplicity_w2 => get_rmultiplicity_fe(W2, mesh%get_id())
            end if

            call rhs_u_broken%initialise( w2b_fs )
            call u_w2b_inc%initialise( w2b_fs )
            call u_w2_inc%initialise( w2_fs )

            call invoke( name="perform_broken_projection_for_wind_inc",          &
                         X_minus_Y( u_w3_inc(1), u_w3_np1(1), u_w3_n(1) ),       &
                         X_minus_Y( u_w3_inc(2), u_w3_np1(2), u_w3_n(2) ),       &
                         X_minus_Y( u_w3_inc(3), u_w3_np1(3), u_w3_n(3) ),       &
                         setval_c(rhs_u_broken, 0.0_r_def),                      &
                         setval_c(rhs_u, 0.0_r_def),                             &
                         setval_c(u_w2_inc, 0.0_r_def),                          &
                         dg_inc_matrix_vector_kernel_type(rhs_u_broken,          &
                                                          u_w3_inc(1),           &
                                                          project_xdot_to_w2),   &
                         dg_inc_matrix_vector_kernel_type(rhs_u_broken,          &
                                                          u_w3_inc(2),           &
                                                          project_ydot_to_w2),   &
                         dg_inc_matrix_vector_kernel_type(rhs_u_broken,          &
                                                          u_w3_inc(3),           &
                                                          project_zdot_to_w2),   &
                         dg_matrix_vector_kernel_type(u_w2b_inc, rhs_u_broken,   &
                                                      mm_w2b_inv),               &
                         average_w2b_to_w2_kernel_type(u_w2_inc, u_w2b_inc,      &
                                                       rmultiplicity_w2),        &
                         matrix_vector_kernel_type(rhs_u, u_w2_inc, mm_w2),      &
                         enforce_bc_kernel_type(rhs_u) )

          else
            ! Assemble right-hand side for Galerkin projection into W2
            call invoke( name="perform_galerkin_projection_for_wind_inc",        &
                         X_minus_Y( u_w3_inc(1), u_w3_np1(1), u_w3_n(1) ),       &
                         X_minus_Y( u_w3_inc(2), u_w3_np1(2), u_w3_n(2) ),       &
                         X_minus_Y( u_w3_inc(3), u_w3_np1(3), u_w3_n(3) ),       &
                         setval_c(rhs_u, 0.0_r_def),                             &
                         matrix_vector_kernel_type(rhs_u, u_w3_inc(1),           &
                                                   project_xdot_to_w2),          &
                         matrix_vector_kernel_type(rhs_u, u_w3_inc(2),           &
                                                   project_ydot_to_w2),          &
                         matrix_vector_kernel_type(rhs_u, u_w3_inc(3),           &
                                                   project_zdot_to_w2),          &
                         enforce_bc_kernel_type(rhs_u) )
          end if

        end if ! native wind transport
        call log_field_minmax( LOG_LEVEL_DEBUG, 'advection increment', rhs_u )

      ! ---------------------------------------------------------------------- !
      ! Default form of transport equation
      ! ---------------------------------------------------------------------- !
      case default
        call log_event(                                                        &
                'Form of wind transport equation either not compatible ' //    &
                'with wind transport or not implemented',                      &
                LOG_LEVEL_ERROR                                                &
        )

      end select

    end if ! si_momentum_equation

    if ( LPROF ) call stop_timing( id_from, 'transport.wind' )

  end subroutine wind_transport_alg

  !=============================================================================
  !> @brief Applies the metric terms to the native W2 wind components.
  !> @details Computes the change in the horizontal and vertical wind
  !!          components over time dt_metric due to the change of the
  !!          coordinate frame along the transporting wind. This is evaluated
  !!          at W3 points and then averaged to the W2H and Wtheta points.
  !> @param[in,out] uv_w2h_out         Horizontal wind with metric terms
  !> @param[in,out] w_wt_out           Vertical wind with metric terms
  !> @param[in]     uv_w2h_in          Horizontal wind to apply terms to
  !> @param[in]     w_wt_in            Vertical wind to apply terms to
  !> @param[in]     transporting_wind  Transporting wind in W2
  !> @param[in]     dA                 Area element in W2
  !> @param[in]     chi_1              First native coordinate field
  !> @param[in]     chi_2              Second native coordinate field
  !> @param[in]     height_w3          Height above the surface radius in W3
  !> @param[in]     rmultiplicity_w2h  Reciprocal multiplicity of W2H DoFs
  !> @param[in]     dt_metric          Time over which the terms are applied
  !> @param[in]     cubed_sphere       Whether coordinates are alpha-beta-r
  !> @param[in]     k_h                Horizontal element order of transport
  !> @param[in]     k_v                Vertical element order of transport
  subroutine apply_wind_metric_terms(uv_w2h_out, w_wt_out,                     &
                                     uv_w2h_in, w_wt_in,                       &
                                     transporting_wind, dA, chi_1, chi_2,      &
                                     height_w3, rmultiplicity_w2h,             &
                                     dt_metric, cubed_sphere, k_h, k_v)

    implicit none

    ! Arguments
    type(field_type),        intent(inout) :: uv_w2h_out
    type(field_type),        intent(inout) :: w_wt_out
    type(field_type),        intent(in)    :: uv_w2h_in
    type(field_type),        intent(in)    :: w_wt_in
    type(r_tran_field_type), intent(in)    :: transporting_wind
    type(field_type),        intent(in)    :: dA
    type(field_type),        intent(in)    :: chi_1
    type(field_type),        intent(in)    :: chi_2
    type(field_type),        intent(in)    :: height_w3
    type(field_type),        intent(in)    :: rmultiplicity_w2h
    real(kind=r_def),        intent(in)    :: dt_metric
    logical(kind=l_def),     intent(in)    :: cubed_sphere
    integer(kind=i_def),     intent(in)    :: k_h, k_v

    ! Internal variables
    type(mesh_type),          pointer :: mesh
    type(function_space_type), pointer :: w3_fs, w2h_fs
    type(field_type)                  :: d_uv1_w3, d_uv2_w3, d_w_w3
    type(field_type)                  :: d_uv_w2h

    mesh => uv_w2h_in%get_mesh()
    w3_fs => function_space_collection%get_fs( mesh, k_h, k_v, W3 )
    w2h_fs => function_space_collection%get_fs( mesh, k_h, k_v, W2h )
    call d_uv1_w3%initialise( w3_fs )
    call d_uv2_w3%initialise( w3_fs )
    call d_w_w3%initialise( w3_fs )
    call d_uv_w2h%initialise( w2h_fs )

    ! The GH_INC kernel loops into the halo, so its target must be set to
    ! zero by setval_c (which PSyclone extends into the halo) rather than
    ! copied from uv_w2h_in
    call invoke( name="apply_wind_metric_terms",                               &
                 wind_metric_increment_w3_kernel_type(                         &
                         d_uv1_w3, d_uv2_w3, d_w_w3,                           &
                         uv_w2h_in, w_wt_in, transporting_wind, dA,            &
                         chi_1, chi_2, height_w3,                              &
                         dt_metric, scaled_radius, cubed_sphere ),             &
                 setval_c( d_uv_w2h, 0.0_r_def ),                              &
                 wind_metric_increment_to_w2h_kernel_type(                     &
                         d_uv_w2h, d_uv1_w3, d_uv2_w3, rmultiplicity_w2h ),    &
                 X_plus_Y( uv_w2h_out, uv_w2h_in, d_uv_w2h ),                  &
                 wind_metric_increment_to_wtheta_kernel_type(                  &
                         w_wt_out, w_wt_in, d_w_w3 ) )

  end subroutine apply_wind_metric_terms

end module wind_transport_alg_mod
