!> Test the kernel that adds wind metric increments from W3 to W2H points.
module wind_metric_increment_to_w2h_kernel_mod_test

  use constants_mod, only : i_def, r_def
  use funit

  implicit none

  private
  public :: test_wind_metric_increment_to_w2h

contains

  !---------------------------------------------------------------------------
  ! W and E points get the xi1 increment, S and N points get minus the xi2
  ! increment, both scaled by the reciprocal multiplicity
  !---------------------------------------------------------------------------
  @Test
  subroutine test_wind_metric_increment_to_w2h()

    use wind_metric_increment_to_w2h_kernel_mod, &
        only: wind_metric_increment_to_w2h_code

    implicit none

    real(kind=r_def), parameter :: tol = 1.0e-14_r_def

    integer(kind=i_def), parameter :: nlayers  = 2
    integer(kind=i_def), parameter :: ndf_w2h  = 4
    integer(kind=i_def), parameter :: undf_w2h = 4*nlayers
    integer(kind=i_def), parameter :: ndf_w3   = 1
    integer(kind=i_def), parameter :: undf_w3  = nlayers

    integer(kind=i_def) :: map_w2h(ndf_w2h), map_w3(ndf_w3)

    real(kind=r_def) :: uv_w2h(undf_w2h), rmultiplicity(undf_w2h)
    real(kind=r_def) :: d_uv1_w3(undf_w3), d_uv2_w3(undf_w3)
    real(kind=r_def) :: answer(undf_w2h)

    map_w2h = (/ 1, 3, 5, 7 /)    ! W, S, E, N
    map_w3  = (/ 1 /)

    uv_w2h(:) = 10.0_r_def
    d_uv1_w3  = (/ 1.0_r_def, 2.0_r_def /)
    d_uv2_w3  = (/ 3.0_r_def, 4.0_r_def /)

    ! W and S points are shared (half of the increment), E and N points are
    ! on a boundary (all of the increment)
    rmultiplicity(1:4) = 0.5_r_def
    rmultiplicity(5:8) = 1.0_r_def

    call wind_metric_increment_to_w2h_code( nlayers,                         &
                                            uv_w2h, d_uv1_w3, d_uv2_w3,      &
                                            rmultiplicity,                   &
                                            ndf_w2h, undf_w2h, map_w2h,      &
                                            ndf_w3, undf_w3, map_w3 )

    answer(1:2) = (/ 10.5_r_def, 11.0_r_def /)    ! W
    answer(3:4) = (/ 8.5_r_def,  8.0_r_def /)     ! S
    answer(5:6) = (/ 11.0_r_def, 12.0_r_def /)    ! E
    answer(7:8) = (/ 7.0_r_def,  6.0_r_def /)     ! N

    @assertEqual(answer, uv_w2h, tol)

  end subroutine test_wind_metric_increment_to_w2h

end module wind_metric_increment_to_w2h_kernel_mod_test
