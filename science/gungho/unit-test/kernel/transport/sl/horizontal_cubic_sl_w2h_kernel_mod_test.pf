!> @brief Test the horizontal cubic semi-Lagrangian kernel for W2H fields.

module horizontal_cubic_sl_w2h_kernel_mod_test

  use constants_mod, only : i_def, r_tran

  implicit none

contains

  !------------------------------------------------------------------

  @Test
  subroutine horizontal_cubic_sl_w2h_kernel_test( )

    use, intrinsic :: iso_fortran_env,  only: real64
    use funit
    use horizontal_cubic_sl_w2h_kernel_mod, only: horizontal_cubic_sl_w2h_code
    use transport_enumerated_types_mod,     only: monotone_none

    implicit none

    real(kind=r_tran), parameter :: tol = 1.0e-12_r_tran
    real(kind=r_tran)            :: use_tol

    integer(kind=i_def), parameter :: nlayers       = 1
    integer(kind=i_def), parameter :: ndf_w2h       = 4
    integer(kind=i_def), parameter :: stencil_max   = 3
    integer(kind=i_def), parameter :: d_stencil_max = 1
    ! 4 dofs × 9 stencil positions each
    integer(kind=i_def), parameter :: undf_w2h      = ndf_w2h * 9

    integer(kind=i_def), dimension(ndf_w2h)                   :: map_w2h
    integer(kind=i_def), dimension(4)                         :: stencil_sizes
    integer(kind=i_def), dimension(ndf_w2h, stencil_max, 4)   :: stencil_map
    integer(kind=i_def), dimension(4)                         :: d_stencil_sizes
    integer(kind=i_def), dimension(ndf_w2h, d_stencil_max, 4) :: d_stencil_map

    real(kind=r_tran), dimension(undf_w2h) :: increment_x
    real(kind=r_tran), dimension(undf_w2h) :: increment_y
    real(kind=r_tran), dimension(undf_w2h) :: field_x
    real(kind=r_tran), dimension(undf_w2h) :: field_y
    real(kind=r_tran), dimension(undf_w2h) :: dep_pts

    integer(kind=i_def) :: i, monotone
    integer(kind=i_def) :: dofs2check(4)

    ! Get correct tolerance
    if ( r_tran == real64 ) then
      use_tol = tol
    else
      use_tol = 1.0e-6_r_tran
    end if

    ! -------------------------------------------------------------------------
    ! Set up maps
    ! -------------------------------------------------------------------------
    ! W=1 at index 1, S=2 at index 10, E=3 at index 19, N=4 at index 28
    map_w2h = (/ 1, 10, 19, 28 /)

    ! Full cross stencil: 3 cells each direction
    stencil_sizes(:) = stencil_max   ! (3,3,3,3)

    ! stencil_map(df, k, dir): each dof (df) has a block of 9 unique indices.
    !   base_df = (df-1)*9 + 1  =>  W:1, S:10, E:19, N:28
    !   dir=1(west)  k=1 centre, k=2 west-1, k=3 west-2
    !   dir=2(south) k=1 centre, k=2 south-1, k=3 south-2
    !   dir=3(east)  k=1 centre, k=2 east-1, k=3 east-2
    !   dir=4(north) k=1 centre, k=2 north-1, k=3 north-2

    ! Initialise to centre values
    stencil_map(1,:,:) = 1   ; stencil_map(2,:,:) = 10
    stencil_map(3,:,:) = 19  ; stencil_map(4,:,:) = 28

    ! W dof (df=1): base 1
    stencil_map(1, 2, 1) = 2  ; stencil_map(1, 3, 1) = 3  ! x west
    stencil_map(1, 2, 2) = 4  ; stencil_map(1, 3, 2) = 5  ! y south
    stencil_map(1, 2, 3) = 6  ; stencil_map(1, 3, 3) = 7  ! x east
    stencil_map(1, 2, 4) = 8  ; stencil_map(1, 3, 4) = 9  ! y north

    ! S dof (df=2): base 10
    stencil_map(2, 2, 1) = 11 ; stencil_map(2, 3, 1) = 12
    stencil_map(2, 2, 2) = 13 ; stencil_map(2, 3, 2) = 14
    stencil_map(2, 2, 3) = 15 ; stencil_map(2, 3, 3) = 16
    stencil_map(2, 2, 4) = 17 ; stencil_map(2, 3, 4) = 18

    ! E dof (df=3): base 19
    stencil_map(3, 2, 1) = 20 ; stencil_map(3, 3, 1) = 21
    stencil_map(3, 2, 2) = 22 ; stencil_map(3, 3, 2) = 23
    stencil_map(3, 2, 3) = 24 ; stencil_map(3, 3, 3) = 25
    stencil_map(3, 2, 4) = 26 ; stencil_map(3, 3, 4) = 27

    ! N dof (df=4): base 28
    stencil_map(4, 2, 1) = 29 ; stencil_map(4, 3, 1) = 30
    stencil_map(4, 2, 2) = 31 ; stencil_map(4, 3, 2) = 32
    stencil_map(4, 2, 3) = 33 ; stencil_map(4, 3, 3) = 34
    stencil_map(4, 2, 4) = 35 ; stencil_map(4, 3, 4) = 36

    ! Departure-point stencil: centre only
    d_stencil_sizes(:) = 1
    d_stencil_map(1, 1, :) = 1   ! dep_pts for W dof
    d_stencil_map(2, 1, :) = 10  ! dep_pts for S dof
    d_stencil_map(3, 1, :) = 19  ! dep_pts for E dof
    d_stencil_map(4, 1, :) = 28  ! dep_pts for N dof

    ! Set fields: field_x(i) = field_y(i) = i
    do i = 1, undf_w2h
      field_x(i) = real(i, r_tran)
      field_y(i) = real(i, r_tran)
    end do

    monotone = monotone_none

    ! -------------------------------------------------------------------------
    ! Test 1: integer departure distance of +1.
    !   x-direction: departure +1 -> advances field_y by one cell west
    !     increment_x(df) = field_y(west-1) - field_y(centre) = 1.0 for all df
    !   y-direction: dep_pts=+1 with direction=-1 -> displacement=-1 -> north by 1
    !     increment_y(df) = field_x(north-1) - field_x(centre) = 7.0 for all df
    ! -------------------------------------------------------------------------
    dep_pts(:) = 1.0_r_tran
    increment_x(:) = 0.0_r_tran
    increment_y(:) = 0.0_r_tran

    call horizontal_cubic_sl_w2h_code( nlayers,          &
                                       increment_x,      &
                                       increment_y,      &
                                       field_x,          &
                                       stencil_sizes,    &
                                       stencil_max,      &
                                       stencil_map,      &
                                       field_y,          &
                                       stencil_sizes,    &
                                       stencil_max,      &
                                       stencil_map,      &
                                       dep_pts,          &
                                       d_stencil_sizes,  &
                                       d_stencil_max,    &
                                       d_stencil_map,    &
                                       monotone,         &
                                       ndf_w2h,          &
                                       undf_w2h,         &
                                       map_w2h )

    dofs2check = (/ 1, 10, 19, 28 /)
    do i = 1,4
      @assertEqual(1.0_r_tran, increment_x(dofs2check(i)), use_tol)
    end do
    ! increment_y = field_x(north-1) - field_x(centre) = +7 for all dofs
    do i = 1,4
      @assertEqual(7.0_r_tran, increment_y(dofs2check(i)), use_tol)
    end do

    ! -------------------------------------------------------------------------
    ! Test 2: zero departure distance -> zero advective increment
    ! -------------------------------------------------------------------------
    dep_pts(:) = 0.0_r_tran
    increment_x(:) = 0.0_r_tran
    increment_y(:) = 0.0_r_tran

    call horizontal_cubic_sl_w2h_code( nlayers,          &
                                       increment_x,      &
                                       increment_y,      &
                                       field_x,          &
                                       stencil_sizes,    &
                                       stencil_max,      &
                                       stencil_map,      &
                                       field_y,          &
                                       stencil_sizes,    &
                                       stencil_max,      &
                                       stencil_map,      &
                                       dep_pts,          &
                                       d_stencil_sizes,  &
                                       d_stencil_max,    &
                                       d_stencil_map,    &
                                       monotone,         &
                                       ndf_w2h,          &
                                       undf_w2h,         &
                                       map_w2h )

    ! With zero departure field_out = field(centre), so increment = 0
    @assertEqual(0.0_r_tran, increment_x(1), use_tol)
    @assertEqual(0.0_r_tran, increment_y(1), use_tol)

  end subroutine horizontal_cubic_sl_w2h_kernel_test

end module horizontal_cubic_sl_w2h_kernel_mod_test
